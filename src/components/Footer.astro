---
import Container from './Container.astro';
import { SOCIAL_PLATFORM_LABELS } from '../lib/format';
import { urlFor } from '../lib/sanity/image';
import type { Settings } from '../lib/sanity/types';

interface Props {
  settings: Settings | null;
  // Helle Haarlinie über dem Footer; die Startseite verzichtet darauf (fließende Abschnittswechsel).
  borderTop?: boolean;
}

const { settings, borderTop = true } = Astro.props;

const churchName = settings?.churchName ?? 'Ankerpunkt';
const year = new Date().getFullYear();

// Footer logo falls back to the global header logo, then to the church name as plain text.
// Build the URL from the asset alone (not the full image value) so no crop/hotspot metadata
// can ever be applied to the logo.
const footerLogoImage = settings?.footerLogo?.asset ? settings.footerLogo : settings?.logo;
const footerLogoUrl = footerLogoImage?.asset ? urlFor(footerLogoImage.asset).height(160).fit('max').url() : null;
const footerLogoAlt = footerLogoImage?.alt || churchName;

const legalLinks = [
  { label: 'Impressum', href: settings?.imprintUrl ?? '/impressum' },
  { label: 'Datenschutz', href: settings?.privacyUrl ?? '/datenschutz' },
];

const exploreLinks = [
  { label: 'Neuigkeiten', href: '/neuigkeiten' },
  { label: 'Veranstaltungen', href: '/veranstaltungen' },
  { label: 'Gruppen', href: '/gruppen' },
  { label: 'Über uns', href: '/ueber-uns' },
];

const hasOfficeHours = Boolean(settings?.officeHours?.length);

// Einheitliche Footer-Typografie: Spaltenüberschriften klein und gesperrt, Inhalte in gut lesbaren
// 15 px. Links mit dezentem Hover und deutlich sichtbarem Tastatur-Fokus.
const headingClass = 'text-[0.8125rem] font-semibold tracking-[0.12em] text-paper uppercase';
const listClass = 'mt-5 space-y-2.5 text-[0.9375rem] leading-relaxed text-anchor-200';
const linkClass =
  'rounded-sm transition-colors duration-200 hover:text-paper focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-anchor-200';
---

<footer class:list={['bg-anchor-900 text-anchor-100', borderTop && 'border-t border-anchor-100']}>
  {/* Logo-/Anschriftspalte etwas breiter als die Linkspalten, damit das Raster ausgewogen wirkt;
      fehlt die Erreichbarkeit-Spalte, verteilen sich die übrigen drei Spalten entsprechend. */}
  <Container
    class:list={[
      'grid grid-cols-1 gap-x-10 gap-y-12 py-14 sm:grid-cols-2 sm:py-16',
      hasOfficeHours ? 'lg:grid-cols-[1.35fr_1fr_1fr_1fr]' : 'lg:grid-cols-[1.35fr_1fr_1fr]',
    ]}
  >
    <div>
      {
        footerLogoUrl ? (
          <img src={footerLogoUrl} alt={footerLogoAlt} class="h-12 w-auto max-w-full object-contain sm:h-14" />
        ) : (
          <p class="font-display text-xl font-medium text-paper">{churchName}</p>
        )
      }
      {settings?.address && (
        <address class="mt-6 not-italic text-[0.9375rem] leading-relaxed text-anchor-200">
          {settings.address.street}<br />
          {settings.address.zip} {settings.address.city}
        </address>
      )}
      {(settings?.phone || settings?.email) && (
        <ul class="mt-4 space-y-1.5 text-[0.9375rem] text-anchor-200">
          {settings?.phone && (
            <li><a href={`tel:${settings.phone.replace(/\s+/g, '')}`} class={linkClass}>{settings.phone}</a></li>
          )}
          {settings?.email && (
            <li><a href={`mailto:${settings.email}`} class:list={[linkClass, 'break-all']}>{settings.email}</a></li>
          )}
        </ul>
      )}
    </div>

    <div>
      <p class={headingClass}>Entdecken</p>
      <ul class={listClass}>
        {exploreLinks.map((link) => (
          <li><a href={link.href} class={linkClass}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    {hasOfficeHours && (
      <div>
        <p class={headingClass}>Erreichbarkeit</p>
        <ul class={listClass}>
          {settings!.officeHours!.map((entry) => (
            <li>
              <span class="block font-medium text-anchor-100">{entry.label}</span>
              <span>{entry.hours}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div>
      <p class={headingClass}>Social Media</p>
      <ul class={listClass}>
        {settings?.socialLinks?.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
              {SOCIAL_PLATFORM_LABELS[link.platform]}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Container>

  <div class="border-t border-anchor-800">
    <Container class="flex flex-col items-center justify-between gap-3 py-6 text-center text-sm text-anchor-300 sm:flex-row sm:text-left">
      <p>{settings?.footerText ?? `© ${year} ${churchName}`}</p>
      <ul class="flex gap-6">
        {legalLinks.map((link) => (
          <li><a href={link.href} class={linkClass}>{link.label}</a></li>
        ))}
      </ul>
    </Container>
  </div>
</footer>
