---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PortableTextContent from '../components/PortableTextContent.astro';
import CtaButton from '../components/CtaButton.astro';
import PageHero from '../components/PageHero.astro';
import ContentImage from '../components/ContentImage.astro';
import CoreValueIcon from '../components/CoreValueIcon.astro';
import { urlFor } from '../lib/sanity/image';
import { getAboutPage, getSettings } from '../lib/sanity/api';
import { buildContactMailto } from '../lib/contact';

const about = await getAboutPage();
const settings = await getSettings();

// Alle redaktionellen Inhalte kommen ausschließlich aus Sanity (Dokument „aboutPage“). Leere
// optionale Felder blenden den jeweiligen Teil aus; es gibt keine Ersatztexte im Code.
const text = (value: string | undefined) => value?.trim() || undefined;

// 1. Titelbild
const heroImage = about?.heroImage?.asset ? about.heroImage : undefined;
const heroVideo = about?.heroBackgroundType === 'video' ? about?.heroVideo?.asset : undefined;
const heroEyebrow = text(about?.heroEyebrow);
// Einzige technische Absicherung: Die Seite braucht immer eine H1 und einen Seitentitel.
const heroHeading = text(about?.heroHeading) ?? 'Über uns';
const heroText = text(about?.heroText);

// 2. Wer wir sind
const whoHeading = text(about?.whoHeading);
const whoLead = text(about?.whoLead);
const whoText = about?.whoText?.length ? about.whoText : undefined;
const groupPhoto = about?.groupPhoto?.asset ? about.groupPhoto : undefined;
const hasWho = Boolean(whoHeading || whoLead || whoText || groupPhoto);

// 3. Kernwerte – Reihenfolge wie im CMS sortiert.
const valuesHeading = text(about?.valuesHeading);
const valuesText = text(about?.valuesText);
const coreValues = about?.coreValues?.filter((value) => value.title?.trim()) ?? [];

// 4. Glaubensbekenntnis
const creedHeading = text(about?.creedHeading);
const creedText = text(about?.creedText);
const creedItems = about?.creedItems?.filter((item) => item.title?.trim()) ?? [];
const creedSourceText = text(about?.creedSourceText);
const creedSourceUrl = text(about?.creedSourceUrl);

// 5. Evangelische Freikirche
const freeChurchHeading = text(about?.freeChurchHeading);
const freeChurchIntro = text(about?.freeChurchIntro);
const freeChurchPrinciples = about?.freeChurchPrinciples?.filter((principle) => principle.title?.trim()) ?? [];
const freeChurchText = about?.freeChurchText?.length ? about.freeChurchText : undefined;
const freeChurchClosing = text(about?.freeChurchClosing);
const freeChurchImage = about?.freeChurchImage?.asset ? about.freeChurchImage : undefined;
const hasFreeChurchCopy = Boolean(freeChurchText || freeChurchClosing);
const hasFreeChurch = Boolean(
  freeChurchHeading || freeChurchIntro || freeChurchPrinciples.length || hasFreeChurchCopy || freeChurchImage,
);

// 6. Ansprechpartner + Einladung
const people = about?.people ?? [];
const peopleHeading = text(about?.peopleHeading);
const contactHeading = text(about?.contactHeading);
const contactText = text(about?.contactText);
const contactLabel = text(about?.buttonText);
// Bevorzugt die Kontakt-E-Mail aus den Globalen Einstellungen (wie auf der Startseite); solange
// keine hinterlegt ist, führt der Button zum Ersatz-Link aus dem CMS bzw. technisch zur Kontaktseite.
const contactHref =
  buildContactMailto(settings?.email, `Kontaktanfrage über ${heroEyebrow ?? settings?.churchName ?? 'die Website'}`) ??
  (text(about?.buttonLink) || '/kontakt');
const hasContact = Boolean(contactHeading || contactText || contactLabel);

// 7. SEO – eigene Seite mit eigener Canonical-URL (BaseLayout, sobald SITE_URL gesetzt ist). Ohne
// SEO-Titel greift die Standardlogik von BaseLayout („Überschrift · Gemeindename“).
const seoTitle = text(about?.seo?.title);
const seoDescription = text(about?.seo?.description) ?? heroText;
const ogSource = about?.seoImage?.asset ? about.seoImage : (heroImage ?? groupPhoto);
const ogImage = ogSource ? urlFor(ogSource).width(1200).height(630).fit('crop').auto('format').url() : undefined;

const IMAGE_SIZES = '(min-width: 1152px) 512px, (min-width: 1024px) 44vw, 100vw';
---

<BaseLayout title={heroHeading} fullTitle={seoTitle} description={seoDescription} ogImage={ogImage} transparentHeader={Boolean(heroImage || heroVideo?.url)} footerBorder={false}>
  {/* 1. Titelbild */}
  <PageHero
    eyebrow={heroEyebrow}
    heading={heroHeading}
    text={heroText}
    image={heroImage}
    video={heroVideo}
    position={about?.heroPosition}
    overlay={about?.heroOverlay}
  />

  {/* 2. Wer wir sind – Einleitung zentriert, darauf die Textblöcke (mit Bild zweispaltig). */}
  {
    hasWho && (
      <section class="py-20 sm:py-24">
        <Container>
          <div data-fade-up>
            <SectionHeading heading={whoHeading} align="center" class="mx-auto" />
            {whoLead && (
              <p
                class:list={[
                  'mx-auto max-w-2xl text-center font-display text-xl leading-snug text-balance text-anchor-700 sm:text-2xl',
                  whoHeading && 'mt-6',
                ]}
              >
                {whoLead}
              </p>
            )}
          </div>

          {(whoText || groupPhoto) && (
            <div
              class:list={[
                (whoHeading || whoLead) && 'mt-14 sm:mt-16',
                groupPhoto && whoText ? 'grid items-center gap-10 lg:grid-cols-2 lg:gap-16' : 'mx-auto max-w-2xl',
              ]}
            >
              {groupPhoto && (
                <div data-fade-up>
                  <ContentImage image={groupPhoto} sizes={IMAGE_SIZES} />
                </div>
              )}
              {whoText && (
                <PortableTextContent
                  data-fade-up
                  value={whoText}
                  class="text-pretty [&_p]:border-l-2 [&_p]:border-sand-300 [&_p]:pl-5 [&_p]:text-lg [&_p]:leading-relaxed sm:[&_p]:pl-6 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&>p+p]:mt-8"
                />
              )}
            </div>
          )}
        </Container>
      </section>
    )
  }

  {/* 3. Kernwerte – Desktop 3 + 2 (zentriert), Tablet zwei Spalten, Smartphone eine Spalte. */}
  {
    coreValues.length > 0 && (
      <section class="bg-paper-muted py-20 sm:py-24">
        <Container>
          <SectionHeading heading={valuesHeading} text={valuesText} align="center" class="mx-auto" data-fade-up />
          <ol class:list={['flex flex-wrap justify-center gap-5 sm:gap-6', (valuesHeading || valuesText) && 'mt-12']}>
            {coreValues.map((value, index) => {
              const imageUrl = value.image?.asset ? urlFor(value.image).width(144).height(144).fit('crop').auto('format').url() : null;
              const hasIcon = !imageUrl && value.icon && value.icon !== 'none';
              return (
                <li
                  data-fade-up
                  style={`--fade-up-delay: ${(index % 3) * 100}ms`}
                  class="relative flex w-full flex-col rounded-3xl bg-paper px-7 pt-7 pb-8 ring-1 ring-ink/5 sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]"
                >
                  <span class="absolute top-5 right-7 font-display text-5xl leading-none font-medium text-sand-300 tabular-nums" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  {imageUrl ? (
                    <img src={imageUrl} alt={value.image?.alt ?? ''} width="56" height="56" loading="lazy" class="h-14 w-14 rounded-full object-cover" />
                  ) : hasIcon ? (
                    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-anchor-50 text-anchor-700 ring-1 ring-anchor-100">
                      <CoreValueIcon icon={value.icon!} />
                    </span>
                  ) : (
                    <span class="h-6" aria-hidden="true" />
                  )}
                  <h3 class="mt-6 pr-10 font-display text-xl leading-snug font-medium text-balance text-ink sm:text-[1.375rem]">
                    {value.title}
                  </h3>
                  {value.text && <p class="mt-3 text-pretty leading-relaxed text-ink-soft">{value.text}</p>}
                </li>
              );
            })}
          </ol>
        </Container>
      </section>
    )
  }

  {/* 4. Glaubensbekenntnis – native details/summary: per Tastatur (Tab, Enter/Leertaste) bedienbar. */}
  {
    creedItems.length > 0 && (
      <section class="py-20 sm:py-24">
        <Container>
          <SectionHeading heading={creedHeading} text={creedText} align="center" class="mx-auto" data-fade-up />
          {/* Die Liste erscheint als Ganzes; beim Aufklappen einzelner Punkte gibt es kein erneutes Fade-up. */}
          <div data-fade-up class:list={['mx-auto max-w-3xl space-y-3', (creedHeading || creedText) && 'mt-12']}>
            {creedItems.map((item, index) => {
              const verses = item.bibleVerses?.filter((verse) => verse?.trim()) ?? [];
              const hasBody = Boolean(item.body?.length);
              const number = (
                <span class="w-6 shrink-0 font-display text-base text-anchor-600 tabular-nums sm:text-lg" aria-hidden="true">
                  {index + 1}
                </span>
              );
              const title = <h3 class="flex-1 font-display text-lg leading-snug font-medium text-ink sm:text-xl">{item.title}</h3>;
              // Ohne Text und Bibelstellen gibt es nichts aufzuklappen: dann eine schlichte Zeile.
              if (!hasBody && verses.length === 0) {
                return (
                  <div class="flex items-center gap-4 rounded-2xl bg-paper-muted px-5 py-5 sm:px-7">
                    {number}
                    {title}
                  </div>
                );
              }
              return (
                <details class="accordion-item group rounded-2xl bg-paper-muted transition-colors duration-300 open:bg-sand-100/60">
                  <summary class="flex cursor-pointer items-center gap-4 rounded-2xl px-5 py-5 select-none hover:text-anchor-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-anchor-700 sm:px-7">
                    {number}
                    {title}
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-paper text-anchor-700 transition-transform duration-300 group-open:rotate-180" aria-hidden="true">
                      <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4">
                        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </summary>
                  <div class="px-5 pb-7 sm:pr-16 sm:pl-[4.25rem]">
                    {hasBody && <PortableTextContent value={item.body} class="prose-p:leading-relaxed [&>*:first-child]:mt-0 [&>*:last-child]:mb-0" />}
                    {verses.length > 0 && (
                      <div class:list={[hasBody && 'mt-5']}>
                        <p class="text-xs font-semibold tracking-wider text-anchor-700 uppercase">Bibelstellen</p>
                        <ul class="mt-2 flex flex-wrap gap-2">
                          {verses.map((verse) => (
                            <li class="rounded-full bg-paper px-3 py-1 text-sm text-ink-soft">{verse}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </details>
              );
            })}
          </div>
          {creedSourceText && creedSourceUrl ? (
            <p class="mt-8 text-center text-sm text-ink-soft">
              <a
                href={creedSourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 underline decoration-anchor-200 underline-offset-4 hover:text-anchor-800 hover:decoration-anchor-500"
              >
                {creedSourceText}
                <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
                  <path d="M6 3h7v7M13 3 5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="sr-only">(öffnet in neuem Tab)</span>
              </a>
            </p>
          ) : (
            creedSourceText && <p class="mt-8 text-center text-sm text-ink-soft">{creedSourceText}</p>
          )}
        </Container>
      </section>
    )
  }

  {/* 5. Evangelische Freikirche – auf warmem Beige, damit sich der Bereich vom Bekenntnis abhebt. */}
  {
    hasFreeChurch && (
      <section class="bg-sand-100/60 py-20 sm:py-24">
        <Container>
          <SectionHeading heading={freeChurchHeading} text={freeChurchIntro} align="center" class="mx-auto max-w-3xl" data-fade-up />

          {freeChurchPrinciples.length > 0 && (
            <ol class:list={['mx-auto max-w-4xl space-y-3', (freeChurchHeading || freeChurchIntro) && 'mt-12']}>
              {freeChurchPrinciples.map((principle, index) => (
                <li
                  data-fade-up
                  style={`--fade-up-delay: ${Math.min(index, 2) * 80}ms`}
                  class="rounded-2xl bg-paper px-6 py-5 sm:grid sm:grid-cols-[minmax(0,16.5rem)_1fr] sm:items-baseline sm:gap-8 sm:px-8 sm:py-6"
                >
                  <h3 class="font-display text-xl font-medium text-anchor-800 sm:text-2xl">{principle.title}</h3>
                  {principle.text && <p class="mt-1.5 text-pretty leading-relaxed text-ink-soft sm:mt-0 sm:text-lg">{principle.text}</p>}
                </li>
              ))}
            </ol>
          )}

          {(hasFreeChurchCopy || freeChurchImage) && (
            <div
              class:list={[
                'mt-14 sm:mt-16',
                freeChurchImage && hasFreeChurchCopy ? 'grid items-center gap-10 lg:grid-cols-2 lg:gap-16' : 'mx-auto max-w-2xl',
              ]}
            >
              {hasFreeChurchCopy && (
                <div data-fade-up>
                  {freeChurchText && (
                    <PortableTextContent
                      value={freeChurchText}
                      class="text-pretty [&_p]:text-lg [&_p]:leading-relaxed [&>*:first-child]:mt-0 [&>*:last-child]:mb-0"
                    />
                  )}
                  {freeChurchClosing && (
                    <p class:list={['rounded-2xl bg-anchor-50 px-5 py-4 leading-relaxed font-medium text-anchor-900 sm:px-6', freeChurchText && 'mt-6']}>
                      {freeChurchClosing}
                    </p>
                  )}
                </div>
              )}
              {freeChurchImage && (
                <div data-fade-up style="--fade-up-delay: 100ms">
                  <ContentImage image={freeChurchImage} sizes={IMAGE_SIZES} />
                </div>
              )}
            </div>
          )}
        </Container>
      </section>
    )
  }

  {/* Ansprechpartner (bestehender Bereich, nur sichtbar, wenn im CMS Personen ausgewählt sind). */}
  {
    people.length > 0 && (
      <section class="pt-20 sm:pt-24">
        <Container>
          <SectionHeading heading={peopleHeading} align="center" class="mx-auto" data-fade-up />
          <div class:list={['flex flex-wrap justify-center gap-6', peopleHeading && 'mt-12']}>
            {people.map((person, index) => {
              const photoUrl = person.photo?.asset ? urlFor(person.photo).width(320).height(320).fit('crop').url() : null;
              const areas = person.responsibleAreas ?? [];
              const hasPersonContact = Boolean(person.email || person.phone);
              const initials = person.name
                .split(' ')
                .map((part) => part[0])
                .slice(0, 2)
                .join('');
              return (
                <div
                  data-fade-up
                  style={`--fade-up-delay: ${(index % 3) * 100}ms`}
                  class="flex w-full flex-col items-center rounded-2xl bg-white p-8 text-center ring-1 ring-anchor-100 sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]"
                >
                  {photoUrl ? (
                    <img src={photoUrl} alt={person.name} width="96" height="96" loading="lazy" class="h-24 w-24 rounded-full object-cover" />
                  ) : (
                    <span class="flex h-24 w-24 items-center justify-center rounded-full bg-anchor-700 text-xl font-medium text-paper" aria-hidden="true">
                      {initials}
                    </span>
                  )}
                  <h3 class="mt-4 font-display text-lg font-medium text-ink">{person.name}</h3>
                  {person.role && <p class="mt-1 text-sm text-anchor-700">{person.role}</p>}
                  {areas.length > 0 && <p class="mt-2 text-xs text-ink-soft/80">{areas.join(' · ')}</p>}
                  {hasPersonContact && (
                    <div class="mt-4 space-y-0.5 text-sm">
                      {person.email && (
                        <a href={`mailto:${person.email}`} class="block text-anchor-700 hover:text-anchor-900">
                          {person.email}
                        </a>
                      )}
                      {person.phone && (
                        <a href={`tel:${person.phone.replace(/\s+/g, '')}`} class="block text-anchor-700 hover:text-anchor-900">
                          {person.phone}
                        </a>
                      )}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </Container>
      </section>
    )
  }

  {/* 6. Einladung – gleiche Kontaktfläche wie auf der Startseite, bewusst ohne Zusatzangaben. */}
  {
    hasContact && (
      <section class="py-16 sm:py-20">
        <Container>
          <div data-fade-up class="flex flex-col items-center rounded-3xl bg-anchor-100/70 px-6 py-10 text-center sm:px-12 sm:py-12 lg:px-16">
            <SectionHeading heading={contactHeading} text={contactText} align="center" class="mx-auto" />
            {contactLabel && (
              <div class:list={[(contactHeading || contactText) && 'mt-7']}>
                <CtaButton
                  href={contactHref}
                  size="lg"
                  class="shadow-[0_6px_18px_-8px_rgba(21,48,46,0.55)] hover:shadow-[0_10px_24px_-10px_rgba(21,48,46,0.6)]"
                >
                  {contactLabel}
                </CtaButton>
              </div>
            )}
          </div>
        </Container>
      </section>
    )
  }
</BaseLayout>
