---
interface Props {
  eyebrow?: string;
  heading?: string;
  text?: string;
  align?: 'left' | 'center';
  class?: string;
  /** Fade-up beim Scrollen (siehe FadeUp.astro). */
  'data-fade-up'?: boolean;
  /** Überschriftenebene; h1, wenn die Überschrift zugleich die Seitenüberschrift ist. */
  level?: 'h1' | 'h2';
}

const { eyebrow, heading, text, align = 'left', class: className = '', 'data-fade-up': fadeUp, level: Heading = 'h2' } = Astro.props;
const centered = align === 'center';
---

<div class:list={['max-w-2xl', centered ? 'mx-auto text-center' : '', className]} data-fade-up={fadeUp}>
  {
    eyebrow && (
      <p class:list={['flex items-center gap-2 text-sm font-semibold tracking-wide text-anchor-600 uppercase', centered ? 'justify-center' : '']}>
        <span class="h-px w-6 bg-anchor-400" />
        {eyebrow}
      </p>
    )
  }
  {heading && <Heading class:list={[eyebrow && 'mt-3', 'text-balance font-display text-3xl font-medium break-words hyphens-auto text-ink sm:text-4xl']}>{heading}</Heading>}
  {text && <p class:list={[heading && 'mt-4', 'text-pretty text-lg leading-relaxed text-ink-soft']}>{text}</p>}
</div>
