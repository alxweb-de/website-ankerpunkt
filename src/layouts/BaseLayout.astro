---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FadeUp from '../components/FadeUp.astro';
import { getSettings } from '../lib/sanity/api';
import { urlFor } from '../lib/sanity/image';

interface Props {
  title: string;
  /** Vollständiger Seitentitel; ersetzt das Schema „Titel – Gemeindename“. */
  fullTitle?: string;
  description?: string;
  ogImage?: string;
  transparentHeader?: boolean;
  footerBorder?: boolean;
  /** Seite nicht in Suchmaschinen aufnehmen (z. B. abgelaufene Veranstaltungen); Links bleiben verfolgbar. */
  noindex?: boolean;
}

const { title, fullTitle, description, ogImage, transparentHeader = false, footerBorder = true, noindex = false } = Astro.props;
const settings = await getSettings();

const siteName = settings?.churchName ?? 'EF-Horhausen';
const pageTitle = fullTitle || (title ? `${title} – ${siteName}` : siteName);
const pageDescription =
  description ??
  'EF-Horhausen (Evangelische Freikirche Horhausen) ist eine lebendige Kirchengemeinde in Horhausen mit offenen Türen für Familien, Jugendliche und Erwachsene.';

// Canonical-URL nur mit konfigurierter Live-Domain (SITE_URL, siehe astro.config.mjs) – sonst
// würde der statische Build auf die Adresse des Build-Rechners (z. B. localhost) verweisen.
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// Vorschaubild für Social Media: ohne eigenes Bild der Seite das Logo aus den Footer-Einstellungen
// (Querformat, passt zum Vorschauformat), ersatzweise das Hauptlogo. Als JPG auf Papierfarbe, da
// soziale Netzwerke transparente Flächen oft schwarz darstellen.
const fallbackOgSource = settings?.footerLogo?.asset ? settings.footerLogo : settings?.logo?.asset ? settings.logo : undefined;
const ogImageUrl =
  ogImage ?? (fallbackOgSource ? urlFor(fallbackOgSource).width(1200).fit('max').bg('faf9f6').format('jpg').url() : undefined);

// Favicon aus den globalen Einstellungen: quadratisch zugeschnitten (Zuschnitt/Hotspot aus dem CMS) und
// stets als PNG, damit der MIME-Type im Link-Tag passt. Die Integration sanity-local-media legt die Dateien
// beim Build unter /media/sanity/ ab – ausgeliefert wird lokal, nicht vom Sanity-CDN. Das Apple-Touch-Icon
// bekommt die Papierfarbe als Hintergrund, da iOS transparente Flächen schwarz füllt.
// Ohne CMS-Favicon bleibt das bisherige /favicon.svg.
const faviconSource = settings?.favicon?.asset ? settings.favicon : undefined;
const faviconUrl = (size: number, background?: string) => {
  const url = urlFor(faviconSource!).width(size).height(size).fit('crop').format('png');
  return (background ? url.bg(background) : url).url();
};
const favicons = faviconSource
  ? { icon32: faviconUrl(32), icon192: faviconUrl(192), appleTouch: faviconUrl(180, 'faf9f6') }
  : undefined;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {
      favicons ? (
        <>
          <link rel="icon" type="image/png" sizes="32x32" href={favicons.icon32} />
          <link rel="icon" type="image/png" sizes="192x192" href={favicons.icon192} />
          <link rel="apple-touch-icon" sizes="180x180" href={favicons.appleTouch} />
        </>
      ) : (
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      )
    }
    {canonicalUrl && !noindex && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content="de_DE" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={siteName} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {/* Schriften liegen lokal (styles/fonts.css, public/fonts) – keine Verbindung zu Google Fonts.
        Die lateinischen Dateien werden vorab geladen, da sie auf jeder Seite gebraucht werden. */}
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta name="generator" content={Astro.generator} />
    {/* Fade-up beim Scrollen für alle Seiten (Elemente mit data-fade-up, siehe FadeUp.astro). */}
    <FadeUp />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-anchor-800 focus:px-4 focus:py-2 focus:text-paper"
    >
      Zum Inhalt springen
    </a>
    <Header settings={settings} transparent={transparentHeader} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer settings={settings} borderTop={footerBorder} />
  </body>
</html>
