---
import AiImageNote from './AiImageNote.astro';
import MediaFrame from './MediaFrame.astro';
import { urlFor } from '../lib/sanity/image';
import type { CoreTopic } from '../lib/sanity/types';

interface Props {
  topic: CoreTopic;
  class?: string;
}

const { topic, class: className = '' } = Astro.props;
const imageUrl = topic.image?.asset ? urlFor(topic.image).width(640).height(420).fit('crop').auto('format').url() : null;
const hasIcon = !imageUrl && topic.icon && topic.icon !== 'none';
---

<a
  href={topic.link}
  class:list={['group flex flex-col overflow-hidden card-shell', className]}
  aria-label={`${topic.title} – mehr erfahren`}
>
  {
    imageUrl && (
      <MediaFrame class="aspect-[16/10] w-full">
        <img
          src={imageUrl}
          alt={topic.image?.alt ?? ''}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      </MediaFrame>
    )
  }
  {/* KI-Kennzeichnung unter dem Bild, damit sie keine Bildinhalte überdeckt. */}
  {imageUrl && topic.image?.aiGenerated && <AiImageNote class="-mb-4 px-8" />}

  <div class:list={['flex flex-1 flex-col items-center gap-3 p-8 text-center', !imageUrl && 'pt-10']}>
    {
      hasIcon && (
        <span class="mb-1 flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-b from-anchor-50 to-anchor-100 text-anchor-700 ring-1 ring-anchor-100 transition-all duration-300 group-hover:from-anchor-100 group-hover:to-anchor-200 group-hover:text-anchor-900 group-hover:ring-anchor-200">
          {topic.icon === 'community' && (
            <svg viewBox="0 0 24 24" fill="none" class="h-8 w-8" aria-hidden="true">
              <circle cx="9" cy="9" r="3.2" stroke="currentColor" stroke-width="1.4" />
              <path d="M3 20c.6-3.3 3-5.2 6-5.2s5.4 1.9 6 5.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              <circle cx="16.5" cy="9.6" r="2.6" stroke="currentColor" stroke-width="1.4" />
              <path d="M14.8 14.6c2.2.2 4 1.9 4.6 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            </svg>
          )}
          {topic.icon === 'faith' && (
            <svg viewBox="0 0 24 24" fill="none" class="h-8 w-8" aria-hidden="true">
              <path d="M12 3v18M7 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          )}
          {topic.icon === 'support' && (
            <svg viewBox="0 0 24 24" fill="none" class="h-8 w-8" aria-hidden="true">
              <path
                d="M17 16c-1.2 1.3-4.5 4.5-4.5 4.5S9.2 17.3 8 16c-2.8-3.1-3.5-4.3-3.5-6.5 0-2.2 1.6-4 4-4 2 0 3.2 1.3 4 2.6.8-1.3 2-2.6 4-2.6 2.4 0 4 1.8 4 4 0 2.2-.7 3.4-3.5 6.5Z"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linejoin="round"
              />
            </svg>
          )}
        </span>
      )
    }
    <h3 class="font-display text-xl font-medium text-ink sm:text-2xl">{topic.title}</h3>
    {topic.text && <p class="text-pretty text-sm leading-relaxed text-ink-soft">{topic.text}</p>}
    <span class="mt-auto flex w-full items-center justify-center gap-1 border-t border-ink/8 pt-4 text-sm font-medium text-anchor-700">
      Mehr erfahren
      <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>
</a>
