---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EventCard from '../../components/EventCard.astro';
import RecurringEventCard from '../../components/RecurringEventCard.astro';
import { getRecurringEvents, getUpcomingEvents } from '../../lib/sanity/api';

const events = await getUpcomingEvents();
const recurringEvents = await getRecurringEvents();
---

<BaseLayout title="Veranstaltungen" description="Alle kommenden Veranstaltungen und regelmäßigen Treffen bei Ankerpunkt.">
  <Container class="py-16 sm:py-20">
    <SectionHeading eyebrow="Termine" heading="Veranstaltungen" text="Diese Termine erwarten dich als Nächstes bei Ankerpunkt." />

    {/* Abgelaufene Termine blendet scripts/eventExpiry.ts auch ohne neuen Build aus. */}
    <div data-event-list>
      {/* Raster als Ganzes einblenden – eventExpiry blendet einzelne Karten dynamisch aus. */}
      <div data-fade-up class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" hidden={events.length === 0} data-event-items>
        {events.map((event) => (
          <EventCard event={event} />
        ))}
      </div>
      <p class="mt-12 text-ink-soft" hidden={events.length > 0} data-event-empty>
        Aktuell sind keine Veranstaltungen geplant. Schau bald wieder vorbei.
      </p>
    </div>
  </Container>

  {
    recurringEvents.length > 0 && (
      <div class="bg-paper-muted py-16 sm:py-20">
        <Container>
          <SectionHeading
            eyebrow="Jede Woche"
            heading="Regelmäßige Veranstaltungen"
            text="Angebote, die regelmäßig stattfinden – für Kinder, Jugendliche und Erwachsene."
            data-fade-up
          />
          <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {/* Fade-up auf einem Wrapper je Karte (die Karte selbst hat eigene Hover-Übergänge). */}
            {recurringEvents.map((item, index) => (
              <div data-fade-up style={`--fade-up-delay: ${(index % 3) * 100}ms`}>
                <RecurringEventCard event={item} class="h-full" />
              </div>
            ))}
          </div>
        </Container>
      </div>
    )
  }
</BaseLayout>

<script>
  import '../../scripts/eventExpiry';
</script>
