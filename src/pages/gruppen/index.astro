---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import GroupCard from '../../components/GroupCard.astro';
import { getGroups } from '../../lib/sanity/api';

const groups = await getGroups();
---

<BaseLayout title="Gruppen" description="Entdecke die Gruppen und Kreise von Ankerpunkt für jedes Alter.">
  <Container class="py-16 sm:py-20">
    <SectionHeading eyebrow="Gemeinschaft" heading="Gruppen" text="Egal ob Kinder, Jugendliche oder Erwachsene – finde deinen Platz in der Gemeinschaft." />

    {
      groups.length > 0 ? (
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {groups.map((group) => (
            <GroupCard group={group} />
          ))}
        </div>
      ) : (
        <p class="mt-12 text-ink-soft">Aktuell sind keine Gruppen eingetragen.</p>
      )
    }
  </Container>
</BaseLayout>
