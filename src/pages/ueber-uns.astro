---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PortableTextContent from '../components/PortableTextContent.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import CtaButton from '../components/CtaButton.astro';
import { urlFor } from '../lib/sanity/image';
import { getAboutPage, getSettings } from '../lib/sanity/api';

const aboutPage = await getAboutPage();
const settings = await getSettings();

const hasGroupPhoto = Boolean(aboutPage?.groupPhoto?.asset);
const photoDimensions = aboutPage?.groupPhoto?.asset?.metadata?.dimensions;

const GROUP_PHOTO_WIDTHS = [640, 960, 1280, 1600, 2000];
const groupPhotoUrl = hasGroupPhoto
  ? urlFor(aboutPage!.groupPhoto!).width(1600).quality(85).auto('format').url()
  : null;
const groupPhotoSrcset = hasGroupPhoto
  ? GROUP_PHOTO_WIDTHS.map(
      (w) => `${urlFor(aboutPage!.groupPhoto!).width(w).quality(w <= 960 ? 80 : 85).auto('format').url()} ${w}w`,
    ).join(', ')
  : undefined;

const heading = aboutPage?.heading || `Was ist ${settings?.churchName ?? 'Ankerpunkt'}?`;
const showButton = Boolean(aboutPage?.buttonText && aboutPage?.buttonLink);
const people = aboutPage?.people ?? [];
---

<BaseLayout
  title="Über uns"
  description={`Lerne ${settings?.churchName ?? 'Ankerpunkt'} kennen – wer wir sind und wer für dich da ist.`}
>
  <section class="py-16 sm:py-20">
    <Container>
      <div class="overflow-hidden rounded-3xl">
        {
          hasGroupPhoto ? (
            <img
              src={groupPhotoUrl!}
              srcset={groupPhotoSrcset}
              sizes="(min-width: 1024px) 1100px, 100vw"
              width={photoDimensions?.width}
              height={photoDimensions?.height}
              alt={aboutPage?.groupPhoto?.alt ?? ''}
              class="h-auto w-full object-contain"
            />
          ) : (
            <PlaceholderImage class="aspect-[16/9] w-full" label="Ankerpunkt Team" />
          )
        }
      </div>

      <div class="mx-auto mt-12 max-w-2xl text-center">
        <SectionHeading eyebrow={aboutPage?.eyebrow} heading={heading} align="center" class="mx-auto" />
        {
          aboutPage?.intro ? (
            <PortableTextContent value={aboutPage.intro} class="mt-6 text-left" />
          ) : (
            <p class="mt-6 text-pretty text-lg leading-relaxed text-ink-soft">
              Wir sind eine lebendige Gemeinde, die Menschen jeden Alters auf ihrem Glaubensweg begleitet.
            </p>
          )
        }
        {
          showButton && (
            <div class="mt-8 flex justify-center">
              <CtaButton href={aboutPage!.buttonLink!}>{aboutPage!.buttonText}</CtaButton>
            </div>
          )
        }
      </div>
    </Container>
  </section>

  {
    people.length > 0 && (
      <section class="bg-paper-muted py-16 sm:py-20">
        <Container>
          <SectionHeading
            eyebrow="Team"
            heading={aboutPage?.peopleHeading || 'Unsere Ansprechpartner'}
            align="center"
            class="mx-auto"
          />
          <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {people.map((person) => {
              const photoUrl = person.photo?.asset
                ? urlFor(person.photo).width(320).height(320).fit('crop').url()
                : null;
              const areas = person.responsibleAreas ?? [];
              const hasContact = Boolean(person.email || person.phone);
              const initials = person.name
                .split(' ')
                .map((part) => part[0])
                .slice(0, 2)
                .join('');
              return (
                <div class="flex flex-col items-center rounded-2xl bg-white p-8 text-center ring-1 ring-anchor-100">
                  {photoUrl ? (
                    <img src={photoUrl} alt={person.name} width="96" height="96" class="h-24 w-24 rounded-full object-cover" />
                  ) : (
                    <span class="flex h-24 w-24 items-center justify-center rounded-full bg-anchor-700 text-xl font-medium text-paper">
                      {initials}
                    </span>
                  )}
                  <p class="mt-4 font-display text-lg font-medium text-ink">{person.name}</p>
                  {person.role && <p class="mt-1 text-sm text-anchor-700">{person.role}</p>}
                  {areas.length > 0 && <p class="mt-2 text-xs text-ink-soft/80">{areas.join(' · ')}</p>}
                  {hasContact && (
                    <div class="mt-4 space-y-0.5 text-sm">
                      {person.email && (
                        <a href={`mailto:${person.email}`} class="block text-anchor-700 hover:text-anchor-900">
                          {person.email}
                        </a>
                      )}
                      {person.phone && (
                        <a href={`tel:${person.phone.replace(/\s+/g, '')}`} class="block text-anchor-700 hover:text-anchor-900">
                          {person.phone}
                        </a>
                      )}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </Container>
      </section>
    )
  }
</BaseLayout>
