---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import PortableTextContent from '../../components/PortableTextContent.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import PersonCard from '../../components/PersonCard.astro';
import CtaButton from '../../components/CtaButton.astro';
import { urlFor } from '../../lib/sanity/image';
import { formatEventDate, portableTextToPlainText, toBerlinIsoString } from '../../lib/format';
import { getEvents, getSettings } from '../../lib/sanity/api';
import type { EventItem } from '../../lib/sanity/types';

// Jede Veranstaltung erhält ihre eigene Seite – auch gleichnamige Termine, da lib/events.ts
// eindeutige Slugs garantiert.
export async function getStaticPaths() {
  const events = await getEvents();
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

const { event }: { event: EventItem } = Astro.props;
const settings = await getSettings();
const siteName = settings?.churchName ?? 'Ankerpunkt';
const labels = formatEventDate(event);

const imageUrl = event.coverImage?.asset ? urlFor(event.coverImage).width(1600).fit('max').url() : null;
const isBookable = event.status !== 'cancelled' && event.status !== 'soldOut' && event.registrationLink;
const isPast = event.visibleUntil <= Date.now();

// SEO – ausschließlich aus vorhandenen Angaben erzeugt, nichts wird ergänzt oder geschätzt.
// Reihenfolge der Textquelle: Kurzbeschreibung (Altdaten) → „Beschreibung der Veranstaltung“ als
// reiner Text → neutraler Hinweis. truncate() kürzt an einer Wortgrenze; da es reiner Text ist,
// entstehen keine abgeschnittenen HTML-Tags.
const descriptionText = portableTextToPlainText(event.description);
const summaryText = event.excerpt || descriptionText;
const seoTitle = `${event.title} am ${labels.shortDate} | ${siteName}`;
const seoDescription = truncate(
  [
    // Gleiche Zeitangabe wie auf der Seite: „10:30 Uhr“ bzw. „10:30–11:30 Uhr“.
    `${event.title} am ${labels.fullDate}${labels.timeLabel ? `, ${labels.timeLabel}` : ''}`,
    event.location ? ` in ${event.location}` : '',
    `. ${summaryText ? summaryText.replace(/([^.!?…])$/, '$1.') : `Alle Infos zum Termin bei ${siteName}.`}`,
  ].join(''),
  160,
);

/** Kürzt auf max. `length` Zeichen an einer Wortgrenze (Suchmaschinen zeigen ca. 155–160 Zeichen). */
function truncate(text: string, length: number) {
  if (text.length <= length) return text;
  return `${text.slice(0, length - 1).replace(/\s+\S*$/, '')}…`;
}

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// Schema.org/Event: Pflichtangaben name + startDate sind immer vorhanden. Ort, Ende, Status, Bild
// und Beschreibung nur, wenn sie tatsächlich gepflegt sind. Veranstalter ist die Gemeinde selbst.
const eventStatus = {
  planned: 'https://schema.org/EventScheduled',
  soldOut: 'https://schema.org/EventScheduled',
  cancelled: 'https://schema.org/EventCancelled',
} as const;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  // Ohne Uhrzeit nur das Datum angeben, statt eine Uhrzeit zu erfinden.
  startDate: event.time ? toBerlinIsoString(new Date(event.start)) : event.date,
  ...(event.end && { endDate: toBerlinIsoString(new Date(event.end)) }),
  ...(event.status && { eventStatus: eventStatus[event.status] }),
  ...(event.location && {
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: { '@type': 'Place', name: event.location, address: event.location },
  }),
  ...(summaryText && { description: truncate(summaryText, 300) }),
  ...(imageUrl && { image: [imageUrl] }),
  ...(canonicalUrl && { url: canonicalUrl }),
  organizer: {
    '@type': 'Organization',
    name: siteName,
    ...(Astro.site && { url: Astro.site.href }),
  },
};
// `<` maskieren, damit Inhalte das Skript-Tag nicht vorzeitig schließen können.
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<BaseLayout title={event.title} fullTitle={seoTitle} description={seoDescription} ogImage={imageUrl ?? undefined}>
  <script is:inline type="application/ld+json" slot="head" set:html={jsonLdHtml} />

  <article class="py-16 sm:py-20">
    <Container class="max-w-3xl">
      <a href="/veranstaltungen" class="inline-flex items-center gap-1.5 text-sm font-medium text-anchor-700 hover:text-anchor-900">
        <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4" aria-hidden="true">
          <path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Alle Veranstaltungen
      </a>

      {
        (event.status && event.status !== 'planned') || event.targetAudience ? (
          <div class="mt-6 flex flex-wrap items-center gap-3">
            {event.status && event.status !== 'planned' && <StatusBadge status={event.status} />}
            {event.targetAudience && (
              <span class="rounded-full bg-anchor-50 px-2.5 py-1 text-xs font-medium text-anchor-700">{event.targetAudience}</span>
            )}
          </div>
        ) : null
      }

      <h1 class="mt-6 text-balance font-display text-3xl font-medium break-words text-ink sm:text-4xl">{event.title}</h1>

      {/* Termin-Block: dasselbe Datumsfeld wie in Liste und Karten, damit alle Ansichten eine Sprache sprechen. */}
      <div class="mt-8 flex items-center gap-5 rounded-3xl bg-anchor-50/60 p-5 sm:gap-6 sm:p-6">
        <time
          datetime={event.time ? toBerlinIsoString(new Date(event.start)) : event.date}
          class="flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-2xl bg-paper text-anchor-900 ring-1 ring-anchor-100"
        >
          <span class="sr-only">{labels.fullDate}</span>
          <span class="text-3xl leading-none font-semibold tabular-nums" aria-hidden="true">{labels.day}</span>
          <span class="mt-1.5 text-xs font-medium tracking-wider text-anchor-700 uppercase" aria-hidden="true">{labels.month}</span>
        </time>
        <div class="min-w-0">
          <p class="text-lg font-medium text-ink sm:text-xl">{labels.fullDate}</p>
          {labels.timeLabel && <p class="mt-1 text-base text-ink-soft sm:text-lg">{labels.timeLabel}</p>}
          {event.location && <p class="mt-1 text-base text-ink-soft">{event.location}</p>}
        </div>
      </div>

      {/* Hinweis für vergangene Termine – wird auch ohne neuen Build sichtbar, sobald der Termin vorbei ist. */}
      <p
        class="mt-6 rounded-2xl bg-sand-50 px-5 py-4 text-sm text-sand-800 ring-1 ring-sand-200/70"
        hidden={!isPast}
        data-show-after={event.visibleUntil}
      >
        Diese Veranstaltung hat bereits stattgefunden.
      </p>

      {/* Ausführliche Beschreibung – ohne Inhalt entfällt der Bereich vollständig. Eigene Begrenzung auf
          eine angenehme Zeilenlänge, da der Container hier breiter ausfällt als für Fließtext ideal. */}
      {
        event.description && (
          <div data-fade-up class="mt-10 max-w-2xl">
            <PortableTextContent value={event.description} />
          </div>
        )
      }

      {event.excerpt && <p class="mt-8 text-lg leading-relaxed text-ink-soft">{event.excerpt}</p>}

      {
        imageUrl && (
          <div data-fade-up class="mt-10 overflow-hidden rounded-3xl bg-anchor-50/60 p-3 sm:p-4">
            <img src={imageUrl} alt={event.coverImage?.alt ?? ''} class="mx-auto max-h-[70vh] w-auto rounded-2xl object-contain" />
          </div>
        )
      }

      {
        isBookable && (
          <div class="mt-8">
            <CtaButton href={event.registrationLink!}>Jetzt anmelden</CtaButton>
          </div>
        )
      }

      {event.body && <PortableTextContent value={event.body} class="mt-10" data-fade-up />}

      {event.contactPerson && <PersonCard person={event.contactPerson} class="mt-10" data-fade-up />}
    </Container>
  </article>
</BaseLayout>

<script>
  import '../../scripts/eventExpiry';
</script>
