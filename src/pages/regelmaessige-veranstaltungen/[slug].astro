---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import AiImageNote from '../../components/AiImageNote.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import PortableTextContent from '../../components/PortableTextContent.astro';
import PersonCard from '../../components/PersonCard.astro';
import { urlFor } from '../../lib/sanity/image';
import { WEEKDAY_LABELS, formatScheduleTime } from '../../lib/format';
import { getRecurringEventBySlug, getRecurringEventSlugs } from '../../lib/sanity/api';

export async function getStaticPaths() {
  const slugs = await getRecurringEventSlugs();
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const event = await getRecurringEventBySlug(slug);

if (!event) {
  return Astro.redirect('/veranstaltungen');
}

const imageUrl = event.mainImage?.asset ? urlFor(event.mainImage).width(1600).fit('max').auto('format').url() : null;
---

<BaseLayout title={event.title} description={event.excerpt} ogImage={imageUrl ?? undefined}>
  <article class="py-16 sm:py-20">
    <Container class="max-w-3xl">
      <a
        href="/veranstaltungen"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-anchor-700 hover:text-anchor-900"
      >
        <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4" aria-hidden="true">
          <path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Alle Veranstaltungen
      </a>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        {event.targetAudience && (
          <span class="rounded-full bg-anchor-50 px-2.5 py-1 text-xs font-medium text-anchor-700">{event.targetAudience}</span>
        )}
        {event.note && (
          <span class="rounded-full bg-sand-100 px-2.5 py-1 text-xs font-medium text-anchor-800">{event.note}</span>
        )}
      </div>

      <h1 class="mt-4 font-display text-3xl font-medium text-ink sm:text-4xl">{event.title}</h1>
      {event.excerpt && <p class="mt-4 text-lg leading-relaxed text-ink-soft">{event.excerpt}</p>}

      <div data-fade-up class="mt-10 overflow-hidden rounded-3xl bg-anchor-50/60 p-3 sm:p-4">
        {
          imageUrl ? (
            <>
              <img
                src={imageUrl}
                alt={event.mainImage?.alt ?? ''}
                class="mx-auto max-h-[70vh] w-auto rounded-2xl object-contain"
              />
              {event.mainImage?.aiGenerated && <AiImageNote class="px-1" />}
            </>
          ) : (
            <div class="aspect-[16/9] overflow-hidden rounded-2xl">
              <PlaceholderImage class="h-full w-full" label={event.title} />
            </div>
          )
        }
      </div>

      {
        event.schedule && event.schedule.length > 0 ? (
          <Fragment>
            <div class="mt-10 flex items-start gap-3 rounded-2xl bg-anchor-50/60 p-6">
              <svg viewBox="0 0 16 16" fill="none" class="mt-0.5 h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
                <path d="M8 14.5S13 10 13 6.5a5 5 0 1 0-10 0C3 10 8 14.5 8 14.5Z" stroke="currentColor" stroke-width="1.3" />
                <circle cx="8" cy="6.5" r="1.8" stroke="currentColor" stroke-width="1.3" />
              </svg>
              <div>
                <p class="text-xs font-medium tracking-wide text-anchor-700 uppercase">Ort</p>
                <p class="mt-1 text-sm text-ink">{event.location}</p>
              </div>
            </div>

            <div class="mt-6">
              <p class="text-xs font-medium tracking-wide text-anchor-700 uppercase">Termine</p>
              <div class="mt-3 divide-y divide-ink/8 overflow-hidden rounded-2xl bg-anchor-50/60 ring-1 ring-anchor-100">
                {event.schedule.map((entry) => (
                  <div class="grid grid-cols-1 gap-1.5 p-4 sm:grid-cols-[8rem_auto_1fr] sm:items-center sm:gap-4">
                    <p class="font-medium text-ink">{WEEKDAY_LABELS[entry.weekday]}</p>
                    <p class="text-sm text-ink-soft">{formatScheduleTime(entry)}</p>
                    <div class="flex flex-wrap gap-2 sm:justify-end">
                      {entry.extra && (
                        <span class="rounded-full bg-white px-2.5 py-1 text-xs font-medium text-anchor-700 ring-1 ring-anchor-100">{entry.extra}</span>
                      )}
                      {entry.note && (
                        <span class="rounded-full bg-white px-2.5 py-1 text-xs font-medium text-anchor-700 ring-1 ring-anchor-100">{entry.note}</span>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </Fragment>
        ) : (
          <div class="mt-10 grid grid-cols-1 gap-6 rounded-2xl bg-anchor-50/60 p-6 sm:grid-cols-2">
            <div class="flex items-start gap-3">
              <svg viewBox="0 0 16 16" fill="none" class="mt-0.5 h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
                <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3" />
                <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
              </svg>
              <div>
                <p class="text-xs font-medium tracking-wide text-anchor-700 uppercase">Termin</p>
                <p class="mt-1 text-sm text-ink">{event.weekday && WEEKDAY_LABELS[event.weekday]}, {event.time}</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg viewBox="0 0 16 16" fill="none" class="mt-0.5 h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
                <path d="M8 14.5S13 10 13 6.5a5 5 0 1 0-10 0C3 10 8 14.5 8 14.5Z" stroke="currentColor" stroke-width="1.3" />
                <circle cx="8" cy="6.5" r="1.8" stroke="currentColor" stroke-width="1.3" />
              </svg>
              <div>
                <p class="text-xs font-medium tracking-wide text-anchor-700 uppercase">Ort</p>
                <p class="mt-1 text-sm text-ink">{event.location}</p>
              </div>
            </div>
          </div>
        )
      }

      <PortableTextContent value={event.body} class="mt-10" data-fade-up />

      {
        event.contactPersons && event.contactPersons.length > 0 && (
          <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {event.contactPersons.map((person, index) => (
              <div data-fade-up style={`--fade-up-delay: ${(index % 2) * 100}ms`}>
                <PersonCard person={person} class="h-full" />
              </div>
            ))}
          </div>
        )
      }
    </Container>
  </article>
</BaseLayout>
