---
import MediaFrame from './MediaFrame.astro';
import PlaceholderImage from './PlaceholderImage.astro';
import { urlFor } from '../lib/sanity/image';
import { formatDate } from '../lib/format';
import type { NewsSummary } from '../lib/sanity/types';

interface Props {
  news: NewsSummary;
  class?: string;
}

const { news, class: className = '' } = Astro.props;
const imageUrl = news.coverImage?.asset
  ? urlFor(news.coverImage).width(640).height(420).fit('crop').url()
  : null;
---

<a href={`/neuigkeiten/${news.slug.current}`} class:list={['group flex flex-col overflow-hidden card-shell', className]}>
  <MediaFrame class="aspect-[16/10] w-full">
    {
      imageUrl ? (
        <img
          src={imageUrl}
          alt={news.coverImage?.alt ?? ''}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <PlaceholderImage class="h-full w-full transition-transform duration-500 group-hover:scale-105" label={news.title} />
      )
    }
  </MediaFrame>
  <div class="flex flex-1 flex-col gap-3 p-6">
    <div class="flex items-center gap-3 text-xs font-semibold tracking-wide uppercase">
      {news.category && <span class="rounded-full bg-anchor-50 px-2.5 py-1 text-anchor-700">{news.category.title}</span>}
      <span class="text-ink-soft/60 normal-case">{formatDate(news.publishedAt)}</span>
    </div>
    <h3 class="font-display text-xl font-medium text-ink">{news.title}</h3>
    <p class="line-clamp-3 text-sm leading-relaxed text-ink-soft">{news.excerpt}</p>
    <span class="mt-auto flex items-center gap-1 border-t border-ink/8 pt-4 text-sm font-medium text-anchor-700">
      Weiterlesen
      <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>
</a>
