---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getNewsList } from '../../lib/sanity/api';

const news = await getNewsList();
---

<BaseLayout title="Neuigkeiten" description="Aktuelle Neuigkeiten und Berichte aus der Gemeinde Ankerpunkt.">
  <Container class="py-16 sm:py-20">
    <SectionHeading eyebrow="Aktuelles" heading="Neuigkeiten" text="Alles, was bei Ankerpunkt gerade passiert." />

    {
      news.length > 0 ? (
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {/* Fade-up auf einem Wrapper je Karte (die Karte selbst hat eigene Hover-Übergänge). */}
          {news.map((item, index) => (
            <div data-fade-up style={`--fade-up-delay: ${(index % 3) * 100}ms`}>
              <NewsCard news={item} class="h-full" />
            </div>
          ))}
        </div>
      ) : (
        <p class="mt-12 text-ink-soft">Aktuell gibt es keine Neuigkeiten.</p>
      )
    }
  </Container>
</BaseLayout>
