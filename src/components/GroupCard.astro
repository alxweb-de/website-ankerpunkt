---
import MediaFrame from './MediaFrame.astro';
import PlaceholderImage from './PlaceholderImage.astro';
import { urlFor } from '../lib/sanity/image';
import { WEEKDAY_LABELS } from '../lib/format';
import type { GroupSummary } from '../lib/sanity/types';

interface Props {
  group: GroupSummary;
  class?: string;
}

const { group, class: className = '' } = Astro.props;
const imageUrl = group.image?.asset ? urlFor(group.image).width(640).height(420).fit('crop').url() : null;
---

<a href={`/gruppen/${group.slug.current}`} class:list={['group flex flex-col overflow-hidden card-shell', className]}>
  <MediaFrame class="aspect-[16/10] w-full">
    {
      imageUrl ? (
        <img
          src={imageUrl}
          alt={group.image?.alt ?? ''}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <PlaceholderImage class="h-full w-full transition-transform duration-500 group-hover:scale-105" label={group.name} />
      )
    }
    {group.ageGroup && (
      <span class="absolute top-4 left-4 rounded-full bg-white/95 px-2.5 py-1 text-xs font-semibold text-anchor-800 shadow-sm">
        {group.ageGroup}
      </span>
    )}
  </MediaFrame>
  <div class="flex flex-1 flex-col gap-3 p-6">
    <h3 class="font-display text-xl font-medium text-ink">{group.name}</h3>
    {group.description && <p class="line-clamp-2 text-sm leading-relaxed text-ink-soft">{group.description}</p>}
    <div class="mt-auto flex items-end justify-between gap-3 border-t border-ink/8 pt-4">
      {group.schedule ? (
        <p class="flex min-w-0 items-center gap-1.5 text-sm text-ink-soft/80">
          <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 shrink-0" aria-hidden="true">
            <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3" />
            <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
          </svg>
          <span class="truncate">{WEEKDAY_LABELS[group.schedule.weekday]}, {group.schedule.time}</span>
        </p>
      ) : <span />}
      <span class="flex shrink-0 items-center gap-1 text-sm font-medium text-anchor-700">
        Details
        <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </div>
</a>
