---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import PortableTextContent from '../../components/PortableTextContent.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import PersonCard from '../../components/PersonCard.astro';
import CtaButton from '../../components/CtaButton.astro';
import { urlFor } from '../../lib/sanity/image';
import { formatDateTimeRange } from '../../lib/format';
import { getEventBySlug, getEventSlugs } from '../../lib/sanity/api';

export async function getStaticPaths() {
  const slugs = await getEventSlugs();
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const event = await getEventBySlug(slug);

if (!event) {
  return Astro.redirect('/veranstaltungen');
}

const imageUrl = event.coverImage?.asset ? urlFor(event.coverImage).width(1600).fit('max').url() : null;
const isBookable = event.status === 'planned' && event.registrationLink;
---

<BaseLayout title={event.seo?.title || event.title} description={event.seo?.description || event.excerpt} ogImage={imageUrl ?? undefined}>
  <article class="py-16 sm:py-20">
    <Container class="max-w-3xl">
      <a href="/veranstaltungen" class="inline-flex items-center gap-1.5 text-sm font-medium text-anchor-700 hover:text-anchor-900">
        <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4" aria-hidden="true">
          <path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Alle Veranstaltungen
      </a>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        {event.status !== 'planned' && <StatusBadge status={event.status} />}
        {event.targetAudience && <span class="rounded-full bg-anchor-50 px-2.5 py-1 text-xs font-medium text-anchor-700">{event.targetAudience}</span>}
      </div>

      <h1 class="mt-4 font-display text-3xl font-medium text-ink sm:text-4xl">{event.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{event.excerpt}</p>

      <div class="mt-10 overflow-hidden rounded-3xl bg-anchor-50/60 p-3 sm:p-4">
        {
          imageUrl ? (
            <img
              src={imageUrl}
              alt={event.coverImage?.alt ?? ''}
              class="mx-auto max-h-[70vh] w-auto rounded-2xl object-contain"
            />
          ) : (
            <div class="aspect-[16/9] overflow-hidden rounded-2xl">
              <PlaceholderImage class="h-full w-full" label={event.title} />
            </div>
          )
        }
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 rounded-2xl bg-anchor-50/60 p-6 sm:grid-cols-2">
        <div class="flex items-start gap-3">
          <svg viewBox="0 0 16 16" fill="none" class="mt-0.5 h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
            <rect x="2.5" y="3" width="11" height="10.5" rx="1.5" stroke="currentColor" stroke-width="1.2" />
            <path d="M2.5 6h11M5.5 1.8v2.4M10.5 1.8v2.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
          </svg>
          <div>
            <p class="text-xs font-medium tracking-wide text-anchor-700 uppercase">Termin</p>
            <p class="mt-1 text-sm text-ink">{formatDateTimeRange(event.startDateTime, event.endDateTime)}</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <svg viewBox="0 0 16 16" fill="none" class="mt-0.5 h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
            <path d="M8 14.5S13 10 13 6.5a5 5 0 1 0-10 0C3 10 8 14.5 8 14.5Z" stroke="currentColor" stroke-width="1.3" />
            <circle cx="8" cy="6.5" r="1.8" stroke="currentColor" stroke-width="1.3" />
          </svg>
          <div>
            <p class="text-xs font-medium tracking-wide text-anchor-700 uppercase">Ort</p>
            <p class="mt-1 text-sm text-ink">{event.location}</p>
          </div>
        </div>
      </div>

      {
        isBookable && (
          <div class="mt-8">
            <CtaButton href={event.registrationLink!}>Jetzt anmelden</CtaButton>
          </div>
        )
      }

      <PortableTextContent value={event.body} class="mt-10" />

      {event.contactPerson && <PersonCard person={event.contactPerson} class="mt-10" />}
    </Container>
  </article>
</BaseLayout>
