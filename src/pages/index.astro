---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import CtaButton from '../components/CtaButton.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SectionHeaderRow from '../components/SectionHeaderRow.astro';
import NewsCard from '../components/NewsCard.astro';
import EventCard from '../components/EventCard.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import RecurringEventsSlider from '../components/RecurringEventsSlider.astro';
import { urlFor } from '../lib/sanity/image';
import { getHomePage, getNewsList, getRecurringEvents, getSettings, getUpcomingEventsLimited } from '../lib/sanity/api';

const homePage = await getHomePage();
const settings = await getSettings();
const recurringEvents = await getRecurringEvents();

const featuredEvents = homePage?.featuredEvents?.length
  ? [...homePage.featuredEvents].sort(
      (a, b) => new Date(a.startDateTime).getTime() - new Date(b.startDateTime).getTime(),
    )
  : await getUpcomingEventsLimited(3);

const featuredNews = homePage?.featuredNews?.length
  ? homePage.featuredNews
  : (await getNewsList()).slice(0, 3);

const hasHeroBackground = Boolean(homePage?.heroBackgroundImage?.asset);

const HERO_BG_WIDTHS = [640, 960, 1280, 1920, 2400];
const heroBackgroundImageUrl = hasHeroBackground
  ? urlFor(homePage!.heroBackgroundImage!).width(2000).quality(82).auto('format').fit('max').url()
  : null;
const heroBackgroundSrcset = hasHeroBackground
  ? HERO_BG_WIDTHS.map(
      (w) => `${urlFor(homePage!.heroBackgroundImage!).width(w).quality(w <= 960 ? 78 : 82).auto('format').fit('max').url()} ${w}w`,
    ).join(', ')
  : undefined;

// CSS object-position value. "center center" is special-cased to sit a bit lower so foreground
// objects (cup, vase, table) stay in frame instead of being cropped at the bottom on desktop.
const HERO_BG_POSITION_STYLE: Record<string, string> = {
  'center center': 'center 55%',
  'center top': 'center top',
  'center bottom': 'center bottom',
  'left center': 'left center',
  'right center': 'right center',
};
const heroBackgroundPositionStyle =
  HERO_BG_POSITION_STYLE[homePage?.heroBackgroundPosition ?? 'center center'] ?? 'center 55%';

const HERO_TEXT_WIDTH_CLASS: Record<string, string> = {
  narrow: 'lg:max-w-[440px]',
  normal: 'lg:max-w-[560px]',
  wide: 'lg:max-w-[680px]',
};
const heroTextWidthClass = HERO_TEXT_WIDTH_CLASS[homePage?.heroTextWidth ?? 'normal'] ?? HERO_TEXT_WIDTH_CLASS.normal;

const heroOverlayOpacity = Math.min(Math.max(homePage?.heroBackgroundOverlay ?? 0, 0), 60) / 100;

const heroShowBottomFade = hasHeroBackground && homePage?.heroBottomFade !== false;

// Exact site background color (--color-paper, #faf9f6) so the fade ends
// on precisely the same tone as the next section — no visible seam.
const PAPER_RGB = '250,249,246';

// The fade lives entirely inside the hero's own box (bottom: 0, no overlap into the next section).
const HERO_BOTTOM_FADE_GRADIENT: Record<string, string> = {
  subtle: `linear-gradient(to bottom,
    rgba(${PAPER_RGB},0) 0%,
    rgba(${PAPER_RGB},0.03) 20%,
    rgba(${PAPER_RGB},0.08) 38%,
    rgba(${PAPER_RGB},0.18) 55%,
    rgba(${PAPER_RGB},0.34) 72%,
    rgba(${PAPER_RGB},0.58) 88%,
    rgb(${PAPER_RGB}) 100%)`,
  medium: `linear-gradient(to bottom,
    rgba(${PAPER_RGB},0) 0%,
    rgba(${PAPER_RGB},0.05) 18%,
    rgba(${PAPER_RGB},0.14) 34%,
    rgba(${PAPER_RGB},0.30) 50%,
    rgba(${PAPER_RGB},0.52) 66%,
    rgba(${PAPER_RGB},0.76) 82%,
    rgb(${PAPER_RGB}) 100%)`,
  strong: `linear-gradient(to bottom,
    rgba(${PAPER_RGB},0) 0%,
    rgba(${PAPER_RGB},0.06) 15%,
    rgba(${PAPER_RGB},0.16) 30%,
    rgba(${PAPER_RGB},0.32) 46%,
    rgba(${PAPER_RGB},0.54) 62%,
    rgba(${PAPER_RGB},0.78) 78%,
    rgba(${PAPER_RGB},0.94) 92%,
    rgb(${PAPER_RGB}) 100%)`,
};

const HERO_BOTTOM_FADE_HEIGHT: Record<string, number> = {
  subtle: 140,
  medium: 180,
  strong: 220,
};

const heroBottomFadeStrength = homePage?.heroBottomFadeStrength ?? 'medium';
const heroBottomFadeGradient = HERO_BOTTOM_FADE_GRADIENT[heroBottomFadeStrength] ?? HERO_BOTTOM_FADE_GRADIENT.medium;
const heroBottomFadeHeight = HERO_BOTTOM_FADE_HEIGHT[heroBottomFadeStrength] ?? HERO_BOTTOM_FADE_HEIGHT.medium;
const heroBottomFadeStyle = `position: absolute; left: 0; right: 0; bottom: 0; height: ${heroBottomFadeHeight}px; background: ${heroBottomFadeGradient};`;

const heroLeftGradientDesktop =
  'linear-gradient(90deg, rgba(248,245,238,0.98) 0%, rgba(248,245,238,0.94) 32%, rgba(248,245,238,0.72) 48%, rgba(248,245,238,0.22) 65%, rgba(248,245,238,0) 78%)';
const heroLeftGradientCompact =
  'linear-gradient(90deg, rgba(248,245,238,0.98) 0%, rgba(248,245,238,0.95) 40%, rgba(248,245,238,0.85) 58%, rgba(248,245,238,0.55) 72%, rgba(248,245,238,0.15) 88%, rgba(248,245,238,0) 100%)';

const showLivestream = Boolean(homePage?.livestreamVisible && (homePage?.livestreamUrl || homePage?.livestreamEmbedUrl));
const livestreamLinkUrl = homePage?.livestreamUrl || homePage?.livestreamEmbedUrl;

const heroInfoItems = homePage?.heroInfoItems ?? [];
const visitAddress = settings?.visitAddress ?? settings?.address;
---

<BaseLayout title="Willkommen" transparentHeader={hasHeroBackground}>
  <section
    class:list={[
      'relative overflow-hidden',
      hasHeroBackground ? 'flex min-h-[700px] items-center' : '',
    ]}
  >
    {/* Hero-Background: fills the hero's own box exactly (inset-0), nothing more. */}
    <div class="absolute inset-0 z-0">
      {
        !hasHeroBackground && (
          <>
            <div class="bg-dot-grid pointer-events-none absolute inset-0 opacity-40 [mask-image:radial-gradient(ellipse_60%_55%_at_50%_0%,black,transparent)]" />
            <div class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full bg-sand-200/40 blur-3xl" />
            <div class="pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-anchor-100/60 blur-3xl" />
          </>
        )
      }

      {
        hasHeroBackground && (
          <>
            <img
              src={heroBackgroundImageUrl!}
              srcset={heroBackgroundSrcset}
              sizes="100vw"
              alt={homePage?.heroBackgroundAlt ?? ''}
              class="absolute inset-0 h-full w-full object-cover"
              style={`object-position: ${heroBackgroundPositionStyle};`}
              fetchpriority="high"
            />
            {/* 1. dezenter allgemeiner heller Schleier */}
            <div class="absolute inset-0 bg-paper/15" />
            {/* 2. linker cremefarbener Verlauf für Textlesbarkeit (Desktop / Tablet+Mobile) */}
            <div class="absolute inset-0 hidden lg:block" style={`background: ${heroLeftGradientDesktop};`} />
            <div class="absolute inset-0 lg:hidden" style={`background: ${heroLeftGradientCompact};`} />
            {/* 3. optionale zusätzliche Abdunklung */}
            {heroOverlayOpacity > 0 && (
              <div class="absolute inset-0 bg-ink" style={`opacity: ${heroOverlayOpacity};`} />
            )}
            {/* 4. weicher Übergang nach unten — bleibt vollständig innerhalb des Hero */}
            {heroShowBottomFade && <div class="pointer-events-none" style={heroBottomFadeStyle} />}
          </>
        )
      }
    </div>

    <Container
      class:list={[
        'relative z-10',
        hasHeroBackground
          ? 'pt-28 pb-20 sm:pt-32 lg:pt-36 lg:pb-28'
          : 'grid grid-cols-1 items-center gap-12 py-16 lg:grid-cols-2 lg:gap-16 lg:py-24',
      ]}
    >
      <div class:list={['motion-safe:animate-fade-up', hasHeroBackground && ['max-w-full sm:max-w-xl', heroTextWidthClass]]}>
        {
          homePage?.heroEyebrow && (
            <p class="flex items-center gap-2 text-sm font-semibold tracking-wide text-anchor-600 uppercase">
              <span class="h-px w-6 bg-anchor-400"></span>
              {homePage.heroEyebrow}
            </p>
          )
        }
        <h1 class="mt-5 text-balance font-display text-4xl leading-[1.1] font-medium text-ink sm:text-5xl lg:text-[3.35rem]">
          {homePage?.heroHeading ?? 'Willkommen bei Ankerpunkt'}
        </h1>
        {
          homePage?.heroText && (
            <p class="mt-5 max-w-lg text-pretty text-lg leading-relaxed text-ink-soft">{homePage.heroText}</p>
          )
        }
        <div class="mt-8 flex flex-wrap gap-4">
          {homePage?.primaryButton && <CtaButton href={homePage.primaryButton.url}>{homePage.primaryButton.label}</CtaButton>}
          {
            homePage?.secondaryButton && (
              <CtaButton href={homePage.secondaryButton.url} variant="secondary">
                {homePage.secondaryButton.label}
              </CtaButton>
            )
          }
        </div>

        {
          heroInfoItems.length > 0 && (
            <dl class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-ink/8 pt-6">
              {heroInfoItems.map((item) => (
                <div class="flex items-center gap-2 text-sm text-ink-soft">
                  {item.icon === 'clock' && (
                    <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 shrink-0 text-anchor-500" aria-hidden="true">
                      <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3" />
                      <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                    </svg>
                  )}
                  {item.icon === 'users' && (
                    <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 shrink-0 text-anchor-500" aria-hidden="true">
                      <circle cx="5.5" cy="6" r="2.2" stroke="currentColor" stroke-width="1.2" />
                      <path d="M1.6 13c.4-2.2 2-3.5 3.9-3.5s3.5 1.3 3.9 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                      <circle cx="11.2" cy="6.4" r="1.8" stroke="currentColor" stroke-width="1.2" />
                      <path d="M9.8 9.7c1.5.1 2.7 1.3 3 3.3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                    </svg>
                  )}
                  {item.icon === 'pin' && (
                    <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 shrink-0 text-anchor-500" aria-hidden="true">
                      <path d="M8 14.5S13 10 13 6.5a5 5 0 1 0-10 0C3 10 8 14.5 8 14.5Z" stroke="currentColor" stroke-width="1.3" />
                      <circle cx="8" cy="6.5" r="1.8" stroke="currentColor" stroke-width="1.3" />
                    </svg>
                  )}
                  <span>{item.text}</span>
                </div>
              ))}
            </dl>
          )
        }
      </div>

      {
        !hasHeroBackground && (
          <div class="motion-safe:animate-fade-up motion-safe:[animation-delay:150ms]">
            <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
              <PlaceholderImage class="aspect-[4/5] w-full rounded-3xl" label="Ankerpunkt Gemeindehaus in Rengsdorf" />
            </div>
          </div>
        )
      }
    </Container>
  </section>

  <section class="py-20">
    <Container>
      <SectionHeaderRow
        eyebrow="Termine"
        heading="Nächste Veranstaltungen"
        linkHref="/veranstaltungen"
        linkLabel="Alle Veranstaltungen ansehen →"
      />

      {
        featuredEvents.length > 0 ? (
          <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {featuredEvents.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        ) : (
          <p class="mt-10 text-ink-soft">Aktuell sind keine Veranstaltungen geplant. Schau bald wieder vorbei.</p>
        )
      }
    </Container>
  </section>

  <section class="border-y border-ink/8 bg-paper-muted py-20">
    <Container>
      <SectionHeaderRow
        eyebrow="Aktuelles"
        heading="Neuigkeiten aus der Gemeinde"
        linkHref="/neuigkeiten"
        linkLabel="Alle Neuigkeiten ansehen →"
      />

      {
        featuredNews.length > 0 ? (
          <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {featuredNews.map((news) => (
              <NewsCard news={news} />
            ))}
          </div>
        ) : (
          <p class="mt-10 text-ink-soft">Aktuell gibt es keine Neuigkeiten.</p>
        )
      }
    </Container>
  </section>

  {
    recurringEvents.length > 0 && (
      <section class="py-20">
        <Container>
          <SectionHeaderRow
            eyebrow="Jede Woche"
            heading="Regelmäßige Veranstaltungen"
            text="Angebote, die regelmäßig stattfinden – für Kinder, Jugendliche und Erwachsene."
          />
          <div class="mt-10">
            <RecurringEventsSlider events={recurringEvents} />
          </div>
          <div class="mt-10 text-center">
            <CtaButton href="/veranstaltungen" variant="secondary">Alle regelmäßigen Veranstaltungen</CtaButton>
          </div>
        </Container>
      </section>
    )
  }

  {
    showLivestream && (
      <section class="bg-anchor-900 py-20 text-paper">
        <Container class="flex flex-col items-start gap-6">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-anchor-800 ring-1 ring-anchor-700">
            <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5 text-paper" aria-hidden="true">
              <path d="M5 7a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7Z" stroke="currentColor" stroke-width="1.5" />
              <path d="M15 10l4-2.5v9L15 14" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </span>
          <SectionHeading
            eyebrow={homePage?.livestreamEyebrow}
            heading={homePage?.livestreamHeadline || 'Gottesdienst per Livestream verfolgen'}
            text={homePage?.livestreamText}
            class="text-paper [&_p]:text-anchor-100 [&_h2]:text-paper"
          />
          <CtaButton href={livestreamLinkUrl!} variant="inverse">{homePage?.livestreamButtonText || 'Zum Livestream'}</CtaButton>
        </Container>
      </section>
    )
  }

  <section class="py-20">
    <Container class="rounded-3xl bg-anchor-50 px-8 py-12 ring-1 ring-anchor-100 sm:px-16">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
        <div>
          <SectionHeading
            eyebrow="Besuch uns"
            heading={settings?.visitHeading || 'Wir freuen uns auf dich'}
            text={settings?.visitText || 'Ob zum Gottesdienst, einer Veranstaltung oder einfach auf einen Kaffee – komm gerne vorbei.'}
          />
          {settings?.visitNote && <p class="mt-4 text-ink-soft">{settings.visitNote}</p>}
          <div class="mt-8">
            <CtaButton href={settings?.visitButton?.url || '/kontakt'}>
              {settings?.visitButton?.label || 'Kontakt aufnehmen'}
            </CtaButton>
          </div>
        </div>
        <div class="space-y-4 text-ink-soft">
          {
            visitAddress && (
              <p class="flex items-start gap-3">
                <svg viewBox="0 0 16 16" fill="none" class="mt-0.5 h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
                  <path d="M8 14.5S13 10 13 6.5a5 5 0 1 0-10 0C3 10 8 14.5 8 14.5Z" stroke="currentColor" stroke-width="1.3" />
                  <circle cx="8" cy="6.5" r="1.8" stroke="currentColor" stroke-width="1.3" />
                </svg>
                <span>
                  {visitAddress.street}<br />
                  {visitAddress.zip} {visitAddress.city}
                </span>
              </p>
            )
          }
          {
            settings?.phone && (
              <p class="flex items-center gap-3">
                <svg viewBox="0 0 16 16" fill="none" class="h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
                  <path d="M3 3.5c0-.6.4-1 1-1h2l1.3 3-1.3 1a8 8 0 0 0 4 4l1-1.3 3 1.3v2c0 .6-.4 1-1 1A10 10 0 0 1 3 3.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
                </svg>
                <a href={`tel:${settings.phone.replace(/\s+/g, '')}`} class="hover:text-anchor-800">{settings.phone}</a>
              </p>
            )
          }
          {
            settings?.email && (
              <p class="flex items-center gap-3">
                <svg viewBox="0 0 16 16" fill="none" class="h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
                  <rect x="2" y="3.5" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.2" />
                  <path d="m3 4.5 5 4 5-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <a href={`mailto:${settings.email}`} class="hover:text-anchor-800">{settings.email}</a>
              </p>
            )
          }
          {
            settings?.officeHours?.map((entry) => (
              <p class="flex items-start gap-3">
                <svg viewBox="0 0 16 16" fill="none" class="mt-0.5 h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
                  <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.2" />
                  <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                </svg>
                <span><strong class="font-medium text-ink">{entry.label}:</strong> {entry.hours}</span>
              </p>
            ))
          }
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
