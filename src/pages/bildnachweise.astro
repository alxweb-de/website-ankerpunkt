---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PortableTextContent from '../components/PortableTextContent.astro';
import { getSettings } from '../lib/sanity/api';
import type { PortableTextValue } from '../lib/sanity/types';

// Hinweise zu Bildquellen und KI-generierten Darstellungen (verlinkt im Footer). Aufbau und Typografie
// wie Impressum und Datenschutz: zentrierte H1, darunter derselbe Renderer in der Variante „legal“.
const settings = await getSettings();
const churchName = settings?.churchName ?? 'Ankerpunkt';

const PARAGRAPHS = [
  'Auf dieser Webseite werden neben eigenen Fotografien auch KI-generierte Bilder und Illustrationen verwendet. Diese dienen der symbolischen und gestalterischen Darstellung unserer Gemeinde, ihrer Werte und Angebote.',
  'KI-generierte Darstellungen zeigen nicht zwangsläufig tatsächliche Räumlichkeiten, Personen oder Veranstaltungen der Evangelischen Freikirche Horhausen.',
  'Die inhaltliche und redaktionelle Verantwortung liegt beim Betreiber der Webseite.',
];
const content: PortableTextValue = PARAGRAPHS.map((text, index) => ({
  _type: 'block',
  _key: `p${index}`,
  style: 'normal',
  markDefs: [],
  children: [{ _type: 'span', _key: `p${index}s`, text, marks: [] }],
}));
---

<BaseLayout title="Bildnachweise & KI-Inhalte" description={`Hinweise zu Bildquellen und KI-generierten Darstellungen auf der Website von ${churchName}.`}>
  <Container class="py-16 sm:py-20">
    <h1 class="text-balance text-center font-display text-3xl leading-tight font-medium break-words hyphens-auto text-ink sm:text-5xl">
      Bildnachweise &amp; KI-Inhalte
    </h1>

    <div class="mx-auto mt-12 max-w-[50rem] sm:mt-14">
      <PortableTextContent value={content} variant="legal" />
    </div>
  </Container>
</BaseLayout>
