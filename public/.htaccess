# Webserver-Einstellungen für STRATO (Apache). Wird mit dem Build ins Wurzelverzeichnis kopiert.

# Keine Verzeichnislisten
Options -Indexes

# Eigene Fehlerseite (src/pages/404.astro)
ErrorDocument 404 /404.html

# Einheitliche Adresse: immer https://ef-horhausen.de (ohne www), dauerhaft per 301.
# Voraussetzung: Das SSL-Zertifikat für ef-horhausen.de und www.ef-horhausen.de ist bei STRATO aktiv.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.ef-horhausen\.de$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://ef-horhausen.de%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Dateitypen, die ältere Serverkonfigurationen nicht immer kennen
AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/avif .avif
AddType video/mp4 .mp4

# Caching: Dateien mit Inhalts-Hash im Namen (/_astro/, /media/sanity/) und Schriften ändern sich nie
# unter derselben Adresse und dürfen lange zwischengespeichert werden; HTML wird stets neu geprüft.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/(_astro|media/sanity|fonts)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
