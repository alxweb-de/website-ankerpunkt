---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PortableTextContent from '../components/PortableTextContent.astro';
import { getSettings } from '../lib/sanity/api';

const settings = await getSettings();
const churchName = settings?.churchName ?? 'Ankerpunkt';
const legalName = settings?.legalEntityName || churchName;
const legalAddress = settings?.legalAddress ?? settings?.address;
const legalEmail = settings?.legalEmail || settings?.email;
const legalPhone = settings?.legalPhone || settings?.phone;
---

<BaseLayout title="Datenschutz" description={`Datenschutzerklärung von ${churchName}.`}>
  <Container class="max-w-3xl py-16 sm:py-20">
    <SectionHeading eyebrow="Rechtliches" heading="Datenschutzerklärung" />

    <div class="prose-ankerpunkt prose mt-10 max-w-none">
      <h2>Verantwortlicher</h2>
      <p>
        Verantwortlich für die Datenverarbeitung auf dieser Website ist:<br />
        {legalName}<br />
        {legalAddress && (
          <>
            {legalAddress.street}<br />
            {legalAddress.zip} {legalAddress.city}<br />
          </>
        )}
        {legalEmail && <>E-Mail: {legalEmail}<br /></>}
        {legalPhone && <>Telefon: {legalPhone}</>}
      </p>
    </div>

    {
      settings?.privacyText ? (
        <PortableTextContent value={settings.privacyText} class="mt-6" />
      ) : (
        <div class="prose-ankerpunkt prose mt-6 max-w-none">
          <h2>Erhebung und Speicherung personenbezogener Daten</h2>
          <p>
            Beim Besuch dieser Website erfasst unser Hosting-Anbieter automatisch Informationen in sogenannten
            Server-Log-Dateien, die dein Browser übermittelt (z. B. IP-Adresse, Datum und Uhrzeit der Anfrage,
            verwendeter Browser). Diese Daten sind nicht bestimmten Personen zuordenbar und werden nicht mit anderen
            Datenquellen zusammengeführt.
          </p>

          <h2>Kontaktaufnahme</h2>
          <p>
            Wenn du per E-Mail oder Telefon Kontakt zu uns aufnimmst, werden deine Angaben zur Bearbeitung der Anfrage
            sowie für mögliche Anschlussfragen bei uns gespeichert. Diese Daten geben wir nicht ohne deine Einwilligung
            weiter.
          </p>

          <h2>Deine Rechte</h2>
          <p>
            Du hast jederzeit das Recht auf Auskunft über deine bei uns gespeicherten personenbezogenen Daten, deren
            Herkunft und Empfänger sowie den Zweck der Datenverarbeitung. Außerdem hast du ein Recht auf Berichtigung,
            Sperrung oder Löschung dieser Daten. Wende dich dazu gerne {legalEmail ? <>an <a href={`mailto:${legalEmail}`}>{legalEmail}</a></> : 'an uns'}.
          </p>

          <h2>Cookies und externe Inhalte</h2>
          <p>
            Diese Website verwendet keine Tracking- oder Marketing-Cookies. Sollten einzelne Seiten externe Inhalte
            einbinden (z. B. einen Livestream-Anbieter), gelten zusätzlich dessen Datenschutzbestimmungen.
          </p>

          <p class="rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-900 ring-1 ring-amber-200">
            Hinweis: Dies sind vorläufige Platzhaltertexte. Bitte rechtlich prüfen und echte Angaben in den
            Globalen Einstellungen unter „Rechtliche Seiten“ ergänzen.
          </p>
        </div>
      )
    }
  </Container>
</BaseLayout>
