---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import CtaButton from '../components/CtaButton.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CoreTopicCard from '../components/CoreTopicCard.astro';
import RecurringEventsSlider from '../components/RecurringEventsSlider.astro';
import UpcomingEventsSection from '../components/UpcomingEventsSection.astro';
import { urlFor } from '../lib/sanity/image';
import { getHomePage, getRecurringEvents, getSettings, getUpcomingEvents } from '../lib/sanity/api';
import type { CoreTopic } from '../lib/sanity/types';

const homePage = await getHomePage();
const settings = await getSettings();
const recurringEvents = await getRecurringEvents();
// Nur kommende Termine, chronologisch sortiert. Was nach dem Build abläuft, blendet
// UpcomingEventsSection zusätzlich im Browser aus.
const upcomingEvents = await getUpcomingEvents();

// Fallback, falls im CMS noch keine Kernthemen-Kacheln gepflegt sind.
const DEFAULT_CORE_TOPICS: CoreTopic[] = [
  { _key: 'community', title: 'Gemeinschaft erleben', icon: 'community', link: '/gemeinschaft-erleben' },
  { _key: 'faith', title: 'Glauben entdecken', icon: 'faith', link: '/glauben-entdecken' },
  { _key: 'support', title: 'Unterstützung erleben', icon: 'support', link: '/unterstuetzung-erleben' },
];
const coreTopics = homePage?.coreTopics?.length ? homePage.coreTopics : DEFAULT_CORE_TOPICS;

// Bildmodus: das Hero-Hintergrundbild. Videomodus: zuerst das eigene Video-Vorschaubild, sonst
// ersatzweise das Hero-Hintergrundbild. So gibt es immer ein Bild als unterste, dauerhafte Ebene —
// das Video (falls vorhanden) spielt rein optisch darüber (siehe Markup weiter unten).
const isVideoMode = homePage?.heroBackgroundType === 'video';
const heroBaseImage = isVideoMode
  ? (homePage?.heroVideoPoster?.asset ? homePage.heroVideoPoster : homePage?.heroBackgroundImage)
  : homePage?.heroBackgroundImage;
const hasHeroBackground = Boolean(heroBaseImage?.asset);

const heroVideoAsset = homePage?.heroBackgroundVideo?.asset;
const hasHeroVideo = isVideoMode && hasHeroBackground && Boolean(heroVideoAsset?.url);
// Das Video läuft standardmäßig auf allen Bildschirmgrößen. Nur eine ausdrücklich im CMS gesetzte
// Deaktivierung blendet es auf Smartphones aus — ein fehlender Wert zählt nicht als „deaktiviert“.
const heroVideoDisableOnMobile = homePage?.heroVideoDisableOnMobile === true;

const HERO_BG_WIDTHS = [640, 960, 1280, 1920, 2400];
const heroBackgroundImageUrl = hasHeroBackground
  ? urlFor(heroBaseImage!).width(2000).quality(82).auto('format').fit('max').url()
  : null;
const heroBackgroundSrcset = hasHeroBackground
  ? HERO_BG_WIDTHS.map(
      (w) => `${urlFor(heroBaseImage!).width(w).quality(w <= 960 ? 78 : 82).auto('format').fit('max').url()} ${w}w`,
    ).join(', ')
  : undefined;

// CSS object-position value. "center center" is special-cased to sit a bit lower so foreground
// objects (cup, vase, table) stay in frame instead of being cropped at the bottom on desktop.
const HERO_BG_POSITION_STYLE: Record<string, string> = {
  'center center': 'center 55%',
  'center top': 'center top',
  'center bottom': 'center bottom',
  'left center': 'left center',
  'right center': 'right center',
};
const heroBackgroundPositionStyle =
  HERO_BG_POSITION_STYLE[homePage?.heroBackgroundPosition ?? 'center center'] ?? 'center 55%';

// Steuert nur noch die Breite des Beschreibungstexts unter dem Zitat (nicht mehr den ganzen Hero-Block,
// damit das Zitat selbst unabhängig davon möglichst einzeilig breit sein darf).
const HERO_TEXT_WIDTH_CLASS: Record<string, string> = {
  narrow: 'max-w-sm',
  normal: 'max-w-md',
  wide: 'max-w-lg',
};
const heroTextWidthClass = HERO_TEXT_WIDTH_CLASS[homePage?.heroTextWidth ?? 'normal'] ?? HERO_TEXT_WIDTH_CLASS.normal;

const heroOverlayOpacity = Math.min(Math.max(homePage?.heroBackgroundOverlay ?? 0, 0), 60) / 100;

const heroShowBottomFade = hasHeroBackground && homePage?.heroBottomFade !== false;

// Exact site background color (--color-paper, #faf9f6) so the fade ends
// on precisely the same tone as the next section — no visible seam.
const PAPER_RGB = '250,249,246';

// The fade lives entirely inside the hero's own box (bottom: 0, no overlap into the next section).
const HERO_BOTTOM_FADE_GRADIENT: Record<string, string> = {
  subtle: `linear-gradient(to bottom,
    rgba(${PAPER_RGB},0) 0%,
    rgba(${PAPER_RGB},0.03) 20%,
    rgba(${PAPER_RGB},0.08) 38%,
    rgba(${PAPER_RGB},0.18) 55%,
    rgba(${PAPER_RGB},0.34) 72%,
    rgba(${PAPER_RGB},0.58) 88%,
    rgb(${PAPER_RGB}) 100%)`,
  medium: `linear-gradient(to bottom,
    rgba(${PAPER_RGB},0) 0%,
    rgba(${PAPER_RGB},0.05) 18%,
    rgba(${PAPER_RGB},0.14) 34%,
    rgba(${PAPER_RGB},0.30) 50%,
    rgba(${PAPER_RGB},0.52) 66%,
    rgba(${PAPER_RGB},0.76) 82%,
    rgb(${PAPER_RGB}) 100%)`,
  strong: `linear-gradient(to bottom,
    rgba(${PAPER_RGB},0) 0%,
    rgba(${PAPER_RGB},0.06) 15%,
    rgba(${PAPER_RGB},0.16) 30%,
    rgba(${PAPER_RGB},0.32) 46%,
    rgba(${PAPER_RGB},0.54) 62%,
    rgba(${PAPER_RGB},0.78) 78%,
    rgba(${PAPER_RGB},0.94) 92%,
    rgb(${PAPER_RGB}) 100%)`,
};

const HERO_BOTTOM_FADE_HEIGHT: Record<string, number> = {
  subtle: 90,
  medium: 120,
  strong: 150,
};

const heroBottomFadeStrength = homePage?.heroBottomFadeStrength ?? 'medium';
const heroBottomFadeGradient = HERO_BOTTOM_FADE_GRADIENT[heroBottomFadeStrength] ?? HERO_BOTTOM_FADE_GRADIENT.medium;
const heroBottomFadeHeight = HERO_BOTTOM_FADE_HEIGHT[heroBottomFadeStrength] ?? HERO_BOTTOM_FADE_HEIGHT.medium;
const heroBottomFadeStyle = `position: absolute; left: 0; right: 0; bottom: 0; height: ${heroBottomFadeHeight}px; background: ${heroBottomFadeGradient};`;

// Dezenter, warmer Verlauf statt einer schweren, gleichmäßigen Abdunklung: das Bild (Bibel, Tisch,
// Pflanzen) soll erkennbar bleiben. Ein warmer Espresso-Ton (statt des kühleren --color-ink) vertieft
// gezielt die Zone hinter dem Text, ohne das ganze Foto gleichmäßig zu verdunkeln oder zu vergrauen.
// Etwas kräftiger als zuvor, damit der Text auch über einem bewegten Hintergrundvideo sicher lesbar
// bleibt — die Ränder des Bildes bleiben davon unberührt (Verlauf endet weiterhin bei 78 %).
const heroCenterScrim =
  'radial-gradient(ellipse 70% 62% at 50% 42%, rgba(42,30,18,0.46) 0%, rgba(42,30,18,0.26) 45%, rgba(42,30,18,0) 78%)';

const heroIdentityName = homePage?.heroIdentityName ?? 'EF-Horhausen';
const heroIdentityTagline = homePage?.heroIdentityTagline ?? 'Evangelische Freikirche Horhausen';
const heroQuote = homePage?.heroHeading ?? 'Jesus lässt Menschen aufblühen';
const heroBibleReference = homePage?.heroBibleReference ?? 'Johannes 10:10';
const heroDescription = homePage?.heroText ?? 'Eine lebendige Gemeinschaft, in der Glaube wächst und Menschen aufblühen.';
const heroCta = homePage?.primaryButton ?? { label: 'Entdecke unsere Gemeinde', url: '/ueber-uns' };
const coreTopicsHeading = homePage?.coreTopicsHeading ?? 'Gemeinschaft. Glaube. Miteinander.';

const visitAddress = settings?.visitAddress ?? settings?.address;

// Der Kontakt-CTA öffnet direkt das E-Mail-Programm mit der allgemeinen Kontakt-E-Mail aus den
// Globalen Einstellungen (Kontakt & Adresse → „E-Mail“). Ohne gültige Adresse wird der Button
// ausgeblendet, statt einen leeren bzw. kaputten mailto:-Link zu erzeugen.
const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const contactEmail = settings?.email?.trim();
const contactMailto =
  contactEmail && EMAIL_PATTERN.test(contactEmail)
    ? `mailto:${contactEmail}?subject=${encodeURIComponent(`Kontaktanfrage über ${heroIdentityName}`)}`
    : null;
---

<BaseLayout title="Willkommen" transparentHeader={hasHeroBackground} footerBorder={false}>
  <section class="min-h-hero relative flex items-center overflow-hidden">
    {/* Unsichtbarer Marker ganz oben im Hero: Header.astro beobachtet ihn per IntersectionObserver,
        um zwischen transparentem und eingefärbtem Zustand umzuschalten — ganz ohne Scroll-Listener. */}
    <div id="hero-scroll-sentinel" class="pointer-events-none absolute top-0 left-0 h-6 w-px" aria-hidden="true" />

    {/* Hero-Background: fills the hero's own box exactly (inset-0), nothing more. */}
    <div class="absolute inset-0 z-0">
      {
        !hasHeroBackground && (
          <>
            <div class="bg-dot-grid pointer-events-none absolute inset-0 opacity-40 [mask-image:radial-gradient(ellipse_60%_55%_at_50%_0%,black,transparent)]" />
            <div class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full bg-sand-200/40 blur-3xl" />
            <div class="pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-anchor-100/60 blur-3xl" />
          </>
        )
      }

      {
        hasHeroBackground && (
          <>
            {/* Bild bleibt als dauerhafte unterste Ebene liegen: Lade-/Fallback-Zustand für ein
                eventuelles Video obendrüber — ganz ohne JavaScript, rein durch CSS-Stapelung. */}
            <img
              src={heroBackgroundImageUrl!}
              srcset={heroBackgroundSrcset}
              sizes="100vw"
              alt={homePage?.heroBackgroundAlt ?? ''}
              class="absolute inset-0 h-full w-full object-cover"
              style={`object-position: ${heroBackgroundPositionStyle};`}
              fetchpriority="high"
            />
            {
              hasHeroVideo && (
                <>
                  {/* Das Video bleibt unsichtbar (opacity-0), bis es tatsächlich abspielt — solange es
                      lädt, blockiert ist (z. B. iOS-Stromsparmodus) oder das Format nicht unterstützt
                      wird, sieht man darunter das Vorschaubild statt eines schwarzen Rahmens oder eines
                      Play-Buttons. Ohne JavaScript wird es per <noscript> direkt eingeblendet. */}
                  <video
                    id="hero-video"
                    class:list={[
                      'absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 ease-out data-[playing=true]:opacity-100 motion-reduce:hidden',
                      heroVideoDisableOnMobile && 'max-sm:hidden',
                    ]}
                    style={`object-position: ${heroBackgroundPositionStyle};`}
                    autoplay
                    muted
                    loop
                    playsinline
                    disablepictureinpicture
                    disableRemotePlayback
                    preload="metadata"
                    aria-hidden="true"
                    tabindex="-1"
                  >
                    <source src={heroVideoAsset!.url} type={heroVideoAsset!.mimeType || 'video/mp4'} />
                  </video>
                  <noscript>
                    <style>{'#hero-video { opacity: 1; }'}</style>
                  </noscript>
                </>
              )
            }
            {/* Dezenter dunkler Verlauf exakt hinter dem transparenten Header, damit Logo und
                Navigation unabhängig vom Bildinhalt lesbar bleiben — der Header selbst bleibt
                dadurch komplett durchsichtig, ohne eigenen Farbbalken. */}
            <div
              class="absolute inset-x-0 top-0 h-28 sm:h-32"
              style="background: linear-gradient(to bottom, rgba(36,26,16,0.55) 0%, rgba(36,26,16,0.22) 60%, rgba(36,26,16,0) 100%);"
            />
            {/* 1. sehr leichter, gleichmäßiger Schleier — gerade genug, damit heller Text überall
                 lesbar bleibt, ohne die warme Raumatmosphäre (Bibel, Tisch, Pflanzen) zu ertränken. */}
            <div class="absolute inset-0 bg-[#241a10]/20" />
            {/* 2. zusätzlicher, zur Mitte hin vertiefender Verlauf genau hinter dem Text */}
            <div class="absolute inset-0" style={`background: ${heroCenterScrim};`} />
            {/* 3. optionale zusätzliche Abdunklung (im CMS einstellbar) */}
            {heroOverlayOpacity > 0 && (
              <div class="absolute inset-0 bg-ink" style={`opacity: ${heroOverlayOpacity};`} />
            )}
            {/* 4. weicher, aber kurzer Übergang nach unten — bleibt vollständig innerhalb des Hero */}
            {heroShowBottomFade && <div class="pointer-events-none" style={heroBottomFadeStyle} />}
          </>
        )
      }
    </div>

    {/* Ein gemeinsamer, zentrierter Inhaltscontainer (statt dreier über die Hero-Höhe verteilter
        Gruppen) — die drei Gruppen (Identität, Zitat+Bibelstelle, Beschreibung+CTA) gehören optisch
        zusammen und werden allein über kontrollierte margin-top-Werte zwischen den Gruppen getrennt.
        `items-center` auf dem Hero-`<section>` zentriert den gesamten Block vertikal; der leichte
        negative Versatz schiebt den optischen Schwerpunkt minimal über die geometrische Mitte.
        Eigene, etwas breitere Spalte (max-w-7xl statt der sonst sitenweiten max-w-6xl-Container-
        Komponente), damit das große Zitat auf breiten Desktops genug Raum hat, um einzeilig zu bleiben.
        Smartphones quer (landscape-short): Die Bildschirmhöhe reicht nicht, um den Block unter dem
        fixierten Header zu zentrieren — daher ohne Versatz, mit oberem Abstand für Header + Safe-Area
        und kompakteren Abständen. Passt der Inhalt trotzdem nicht, wächst der Hero (min-height) einfach
        über die Bildschirmhöhe hinaus und man scrollt ganz normal weiter. */}
    <div class="relative z-10 mx-auto w-full max-w-7xl -translate-y-3 px-6 py-8 sm:py-10 sm:-translate-y-4 lg:px-8 lg:py-12 lg:-translate-y-6 landscape-short:translate-y-0 landscape-short:pt-[calc(5.25rem+env(safe-area-inset-top,0px))] landscape-short:pb-10">
      <div class="motion-safe:animate-fade-up mx-auto flex flex-col items-center text-center">
        {/* Gruppe 1 — Gemeindeidentität: bildet bewusst eine kompakte, zurückhaltende Einheit — der
            Name etwas fester, der ausgeschriebene Zusatz deutlich kleiner und leiser darunter. */}
        <p class="flex flex-col items-center gap-1.5 landscape-short:gap-1">
          <span
            class:list={[
              'font-display text-lg font-semibold tracking-wide sm:text-xl landscape-short:text-lg',
              hasHeroBackground ? 'text-paper [text-shadow:0_1px_10px_rgba(20,14,8,0.35)]' : 'text-ink',
            ]}
          >
            {heroIdentityName}
          </span>
          <span
            class:list={[
              'text-xs font-medium tracking-[0.12em] sm:text-sm landscape-short:text-xs',
              hasHeroBackground ? 'text-paper/70 [text-shadow:0_1px_8px_rgba(20,14,8,0.3)]' : 'text-ink-soft/80',
            ]}
          >
            {heroIdentityTagline}
          </span>
        </p>

        {/* Gruppe 2 — Zitat + Bibelstelle: als zusammengehörige Einheit mit knappem Abstand
            zwischen den beiden. Auf Mobile/Tablet darf das Zitat ganz normal umbrechen
            (text-balance verteilt die Zeilen ausgewogen). Ab lg steht es dank clamp()-Schriftgröße in
            einer Zeile: die Größe wächst stufenlos mit der Viewport-Breite bis zu einem sicheren
            Höchstwert (abgestimmt auf die Breite der Spalte oben) und bleibt darüber hinaus konstant —
            „ … “ bricht dadurch bei keiner Desktopbreite um oder läuft über. */}
        <h1
          class:list={[
            'mt-6 w-full max-w-4xl text-balance font-display font-medium tracking-[-0.01em] sm:mt-8',
            'text-4xl leading-[1.25] sm:text-5xl',
            'lg:mt-10 lg:max-w-none lg:text-nowrap lg:text-[clamp(2.1rem,4vw+0.5rem,3.7rem)] lg:leading-[1.2]',
            'landscape-short:mt-4 landscape-short:max-w-3xl landscape-short:text-wrap landscape-short:text-[2rem] landscape-short:leading-[1.2]',
            hasHeroBackground ? 'text-paper [text-shadow:0_2px_22px_rgba(20,14,8,0.42)]' : 'text-ink',
          ]}
        >
          <span aria-hidden="true">„</span>
          {heroQuote}
          <span aria-hidden="true">“</span>
        </h1>

        <p
          class:list={[
            'mt-3 text-sm font-medium tracking-wide italic sm:mt-4 sm:text-base landscape-short:mt-2 landscape-short:text-sm',
            hasHeroBackground ? 'text-paper/80 [text-shadow:0_1px_8px_rgba(20,14,8,0.3)]' : 'text-anchor-600',
          ]}
        >
          {heroBibleReference}
        </p>

        {/* Gruppe 3 — Beschreibung + CTA: eigene Untereinheit mit knappem, harmonischem Abstand
            zwischen Text und Button. */}
        <p
          class:list={[
            'mx-auto mt-8 text-pretty text-lg leading-[1.7] sm:mt-10 sm:text-xl lg:mt-12',
            'landscape-short:mt-5 landscape-short:text-base landscape-short:leading-relaxed',
            heroTextWidthClass,
            hasHeroBackground ? 'text-paper/90 [text-shadow:0_1px_10px_rgba(20,14,8,0.3)]' : 'text-ink-soft',
          ]}
        >
          {heroDescription}
        </p>

        <div class="mt-6 sm:mt-7 lg:mt-8 landscape-short:mt-5">
          <CtaButton
            href={heroCta.url}
            variant={hasHeroBackground ? 'inverse' : 'primary'}
            size={hasHeroBackground ? 'lg' : 'md'}
            class="group"
          >
            {heroCta.label}
            <svg viewBox="0 0 16 16" fill="none" class="h-[18px] w-[18px] shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </CtaButton>
        </div>
      </div>
    </div>

    {/* Scroll-Pfeil horizontal zentriert über inset-x-0 + mx-auto statt left-1/2 + translate: so kann
        die Wipp-Animation (transform) die Zentrierung nicht verschieben. */}
    {
      hasHeroBackground && (
        <a
          href="#kernthemen"
          aria-label="Zum nächsten Bereich scrollen"
          class:list={[
            'group absolute inset-x-0 bottom-10 z-10 mx-auto flex h-12 w-12 items-center justify-center rounded-full',
            'bg-ink/15 text-paper ring-1 ring-paper/40 backdrop-blur-sm',
            'transition-colors duration-200 hover:bg-ink/25 hover:ring-paper/60',
            'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper',
            'motion-safe:animate-hero-chevron sm:bottom-12 sm:h-14 sm:w-14',
            '[@media(max-height:640px)]:hidden',
          ]}
        >
          <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6 transition-transform duration-200 group-hover:translate-y-0.5 sm:h-7 sm:w-7" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      )
    }
  </section>

  {/* Abschnittswechsel ohne Trennlinien: Der Hero läuft über seinen Verlauf nahtlos in den hellen
      Hintergrund aus, danach trennen nur Weißraum und Hintergrundwechsel die Bereiche.
      Alle Abschnittsüberschriften der Startseite nutzen einheitlich die zentrierte SectionHeading
      (max. ca. 670 px Breite) mit jeweils mt-12 Abstand zum folgenden Inhalt. */}
  <section id="kernthemen" class="scroll-mt-20 py-20">
    <Container>
      <SectionHeading heading={coreTopicsHeading} align="center" class="mx-auto" />
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {coreTopics.map((topic) => (
          <CoreTopicCard topic={topic} class="h-full" />
        ))}
      </div>
    </Container>
  </section>

  {
    recurringEvents.length > 0 && (
      <section class="bg-paper-muted py-20">
        <Container>
          <SectionHeading
            heading="Regelmäßige Veranstaltungen"
            text="Angebote, die regelmäßig stattfinden – für Kinder, Jugendliche und Erwachsene."
            align="center"
            class="mx-auto"
          />
          <div class="mt-12">
            <RecurringEventsSlider events={recurringEvents} />
          </div>
          <div class="mt-10 text-center">
            <CtaButton href="/veranstaltungen" variant="secondary" size="lg" class="max-sm:px-6 max-sm:text-[0.9375rem]">
              Alle regelmäßigen Veranstaltungen
            </CtaButton>
          </div>
        </Container>
      </section>
    )
  }

  <UpcomingEventsSection
    events={upcomingEvents}
    heading={homePage?.upcomingEventsHeading || undefined}
    text={homePage?.upcomingEventsText || undefined}
    limit={homePage?.upcomingEventsLimit ?? 5}
    hideWhenEmpty={homePage?.upcomingEventsHideWhenEmpty ?? false}
  />

  <section class="py-16 sm:py-20">
    <Container>
      {/* Kontaktfläche als eigene Box innerhalb des Containers (statt Box-Klassen auf dem Container,
          deren Innenabstände sonst mit dessen px-Klassen kollidieren). Hierarchie: Einladung →
          zentrale Handlungsaufforderung → praktische Besuchsinformationen als ruhige Ergänzung.
          Bewusst kompakt gehalten, damit der Bereich nicht wie ein eigener großer Seitenabschnitt
          wirkt. Der CMS-Hinweistext (visitNote) wird hier nicht angezeigt — er wiederholt die
          Einladung inhaltlich; das Feld bleibt im CMS erhalten. */}
      <div class="flex flex-col items-center rounded-3xl bg-anchor-100/70 px-6 py-9 text-center sm:px-12 lg:px-16">
        <SectionHeading
          heading={settings?.visitHeading || 'Wir freuen uns auf dich!'}
          text={
            settings?.visitText ||
            'Du hast Fragen, möchtest uns kennenlernen oder suchst den persönlichen Austausch? Wir freuen uns, von dir zu hören.'
          }
          align="center"
          class="mx-auto"
        />
        {
          contactMailto && (
            <div class="mt-6">
              <CtaButton
                href={contactMailto}
                size="lg"
                class="shadow-[0_6px_18px_-8px_rgba(21,48,46,0.55)] hover:shadow-[0_10px_24px_-10px_rgba(21,48,46,0.6)]"
              >
                {settings?.visitButton?.label || 'Kontakt aufnehmen'}
              </CtaButton>
            </div>
          )
        }

        {/* Praktische Informationen: je Eintrag Icon über zentriertem Text — auf dem Smartphone
            untereinander, ab md in drei gleich breiten Spalten. flex-wrap + feste Spaltenbreiten
            halten auch eine abweichende Anzahl Einträge mittig. */}
        <ul class="mt-7 flex w-full flex-wrap justify-center gap-x-8 gap-y-5 text-base leading-normal text-ink-soft">
          {
            visitAddress && (
              <li class="flex w-full flex-col items-center gap-2.5 md:w-[calc((100%-4rem)/3)]">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-paper/80 text-anchor-700" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" class="h-5 w-5">
                    <path d="M8 14.5S13 10 13 6.5a5 5 0 1 0-10 0C3 10 8 14.5 8 14.5Z" stroke="currentColor" stroke-width="1.3" />
                    <circle cx="8" cy="6.5" r="1.8" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                </span>
                <address class="not-italic">
                  <span class="block font-medium text-ink">{visitAddress.street}</span>
                  {visitAddress.zip} {visitAddress.city}
                </address>
              </li>
            )
          }
          {
            settings?.phone && (
              <li class="flex w-full flex-col items-center gap-2.5 md:w-[calc((100%-4rem)/3)]">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-paper/80 text-anchor-700" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" class="h-5 w-5">
                    <path d="M3 3.5c0-.6.4-1 1-1h2l1.3 3-1.3 1a8 8 0 0 0 4 4l1-1.3 3 1.3v2c0 .6-.4 1-1 1A10 10 0 0 1 3 3.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
                  </svg>
                </span>
                <a href={`tel:${settings.phone.replace(/\s+/g, '')}`} class="font-medium text-ink hover:text-anchor-700">{settings.phone}</a>
              </li>
            )
          }
          {
            settings?.officeHours?.map((entry) => (
              <li class="flex w-full flex-col items-center gap-2.5 md:w-[calc((100%-4rem)/3)]">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-paper/80 text-anchor-700" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" class="h-5 w-5">
                    <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.2" />
                    <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                  </svg>
                </span>
                <p class="text-balance">
                  <span class="block font-medium text-ink">{entry.label}</span>
                  {entry.hours}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  // Blendet das Hero-Video erst ein, sobald es wirklich läuft (siehe opacity-0 im Markup), und lässt
  // es nur laufen, solange der Hero sichtbar und der Tab im Vordergrund ist. pause()/play() setzen an
  // derselben Stelle fort; bereits geladene Videodaten bleiben erhalten. Bei reduzierter Bewegung
  // bleibt das Video angehalten — das Vorschaubild darunter ist dann sichtbar.
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const hero = video?.closest('section');
  if (video && hero) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const abort = new AbortController();
    const { signal } = abort;
    // Bis der Observer zum ersten Mal meldet, gilt der Hero als sichtbar (Seite startet oben).
    let heroInView = true;

    const markPlaying = () => (video.dataset.playing = 'true');
    const sync = () => {
      const shouldPlay = heroInView && document.visibilityState === 'visible' && !reducedMotion.matches;
      if (!shouldPlay) {
        if (!video.paused) video.pause();
        return;
      }
      if (!video.paused) return;
      // Manche Browser (v. a. iOS Safari) brauchen das muted-Property zusätzlich zum Attribut.
      video.muted = true;
      video.play().catch(() => {
        // Wiedergabe blockiert (z. B. Stromsparmodus): Vorschaubild bzw. letzter Frame bleibt stehen.
      });
    };

    // Der Observer meldet sich nur beim Über- bzw. Unterschreiten der Grenze, nicht bei jedem
    // Scroll-Pixel. Der negative obere rootMargin zählt den Hero erst dann als „nicht mehr sichtbar“,
    // wenn höchstens noch ein schmaler Streifen (20 % der Viewport-Höhe) oben hervorschaut.
    const observer =
      'IntersectionObserver' in window
        ? new IntersectionObserver(
            ([entry]) => {
              heroInView = entry.isIntersecting;
              sync();
            },
            { rootMargin: '-20% 0px 0px 0px', threshold: 0 },
          )
        : null;
    observer?.observe(hero);

    video.addEventListener('playing', markPlaying, { signal });
    document.addEventListener('visibilitychange', sync, { signal });
    reducedMotion.addEventListener('change', sync, { signal });
    // Endgültiges Verlassen der Seite: Observer und Listener aufräumen. Bleibt die Seite im
    // Back-/Forward-Cache (persisted), bleibt alles aktiv, damit das Video beim Zurückkehren weiterläuft.
    window.addEventListener(
      'pagehide',
      (event) => {
        if (event.persisted) return;
        observer?.disconnect();
        abort.abort();
      },
      { signal },
    );

    if (!video.paused && video.readyState > 2) markPlaying();
    sync();
  }
</script>
