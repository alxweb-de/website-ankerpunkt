---
import BaseLayout from '../layouts/BaseLayout.astro';
import AiImageNote from '../components/AiImageNote.astro';
import Container from '../components/Container.astro';
import PortableTextContent from '../components/PortableTextContent.astro';
import ContentImage from '../components/ContentImage.astro';
import CoreValueIcon from '../components/CoreValueIcon.astro';
import CtaButton from '../components/CtaButton.astro';
import PageHero from '../components/PageHero.astro';
import { buildContactMailto } from '../lib/contact';
import { urlFor } from '../lib/sanity/image';
import { getSettings, getTopicPage } from '../lib/sanity/api';
import type { PortableTextValue, SanityImageData } from '../lib/sanity/types';

const page = await getTopicPage('topicPage-gemeinschaft');
const settings = await getSettings();

// Ankerpunkt – Das offene Wohnzimmer. Alle redaktionellen Inhalte kommen ausschließlich aus Sanity
// (Dokument „topicPage-gemeinschaft“, neuer Seitenaufbau). Leere optionale Felder blenden den jeweiligen
// Teil aus; es gibt keine Ersatztexte im Code. Die bisherigen Felder (eyebrow, intro, Buttons,
// Kurzpunkte) werden nicht mehr gezeigt.
const text = (value: string | undefined) => value?.trim() || undefined;
const richText = (value: PortableTextValue | undefined) => (value?.length ? value : undefined);
const withAsset = <T extends SanityImageData>(image: T | undefined) => (image?.asset ? image : undefined);

// 1. Titelbild
const heroImage = withAsset(page?.heroImage);
const heroVideo = page?.heroBackgroundType === 'video' ? page?.heroVideo?.asset : undefined;
// Einzige technische Absicherung: Die Seite braucht immer eine H1 und einen Seitentitel.
const heroHeading = text(page?.heroHeading) ?? text(page?.heading) ?? 'Gemeinschaft erleben';
const heroText = text(page?.heroText);

// 2. Ankerpunkt-Vorstellung: Original-Logo unverzerrt (fit max), darunter Überschrift und Text.
const welcomeLogo = withAsset(page?.welcomeLogo);
const welcomeHeading = text(page?.welcomeHeading);
const welcomeText = richText(page?.welcomeText);
const welcomeImage = withAsset(page?.welcomeImage);
const hasWelcome = Boolean(welcomeLogo || welcomeHeading || welcomeText || welcomeImage);
const logoDims = welcomeLogo?.asset?.metadata?.dimensions;
const LOGO_WIDTHS = [160, 240, 320, 480];
const logoSrcset = welcomeLogo
  ? LOGO_WIDTHS.map((w) => `${urlFor(welcomeLogo).width(w).fit('max').auto('format').url()} ${w}w`).join(', ')
  : undefined;

// 3. Unsere Idee: Einleitung plus Kerngedanken (Reihenfolge aus dem CMS).
const ideaHeading = text(page?.ideaHeading);
const ideaText = richText(page?.ideaText);
const ideaPoints = page?.ideaPoints?.filter((point) => point.title?.trim()) ?? [];
const hasIdea = Boolean(ideaHeading || ideaText || ideaPoints.length);

// 4. Mitmachen – kein Formular. Empfänger: Projekt-E-Mail, sonst Ansprechpartner, sonst Kontakt-E-Mail
// aus den Globalen Einstellungen. Ohne gültige Adresse der Ersatz-Link aus dem CMS (leer: kein Button).
const joinHeading = text(page?.joinHeading);
const joinText = richText(page?.joinText);
const joinButtonText = text(page?.joinButtonText);
const joinSubject = text(page?.joinMailSubject) ?? heroHeading;
const joinHref =
  buildContactMailto(page?.joinEmail, joinSubject) ??
  buildContactMailto(page?.joinContactPerson?.email, joinSubject) ??
  buildContactMailto(settings?.email, joinSubject) ??
  text(page?.joinFallbackLink);
const showJoinButton = Boolean(joinButtonText && joinHref);
const hasJoin = Boolean(joinHeading || joinText || showJoinButton);

// 5. Bildergalerie – nur mit echten Bildern und wenn im CMS eingeschaltet.
const galleryImages = page?.galleryImages?.filter((image) => image?.asset) ?? [];
const galleryHeading = text(page?.galleryHeading);
const hasGallery = page?.galleryVisible !== false && galleryImages.length > 0;
const galleryColumns =
  galleryImages.length === 1 ? 'mx-auto max-w-3xl' : galleryImages.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
const GALLERY_WIDTHS = [480, 720, 960, 1280];
const gallerySrc = (image: SanityImageData, width: number) =>
  urlFor(image).width(width).height(Math.round((width * 3) / 4)).fit('crop').auto('format').quality(80).url();

// 6. SEO – eigene Canonical-URL über BaseLayout (sobald SITE_URL gesetzt ist).
const seoTitle = text(page?.seo?.title);
const seoDescription = text(page?.seo?.description) ?? heroText;
const ogSource = withAsset(page?.seoImage) ?? heroImage;
const ogImage = ogSource ? urlFor(ogSource).width(1200).height(630).fit('crop').auto('format').url() : undefined;

const SECTION_HEADING = 'mx-auto max-w-3xl text-balance text-center font-display text-3xl leading-tight font-medium text-ink sm:text-4xl lg:text-[2.75rem]';
// Fließtext linksbündig; der erste Absatz etwas größer als Einstieg.
const BODY_TEXT =
  'text-pretty [&_p]:text-lg [&_p]:leading-relaxed sm:[&>p:first-child]:text-xl [&>p:first-child]:text-ink [&>*:first-child]:mt-0 [&>*:last-child]:mb-0';
---

<BaseLayout title={heroHeading} fullTitle={seoTitle} description={seoDescription} ogImage={ogImage} transparentHeader={Boolean(heroImage || heroVideo?.url)} footerBorder={false}>
  {/* 1. Titelbild – sofort sichtbar, kein Scroll-Fade-up. */}
  <PageHero
    eyebrow={text(page?.heroEyebrow)}
    heading={heroHeading}
    subtitle={text(page?.heroSubtitle)}
    text={heroText}
    image={heroImage}
    video={heroVideo}
    position={page?.heroPosition}
    overlay={page?.heroOverlay}
  />

  {/* 2. Ankerpunkt vorstellen – warmweiß. */}
  {
    hasWelcome && (
      <section class="py-20 sm:py-24 lg:py-28">
        <Container>
          <div data-fade-up>
            {welcomeLogo && (
              <img
                src={urlFor(welcomeLogo).width(320).fit('max').auto('format').url()}
                srcset={logoSrcset}
                sizes="(min-width: 640px) 160px, 128px"
                width={logoDims?.width}
                height={logoDims?.height}
                alt={welcomeLogo.alt ?? ''}
                loading="lazy"
                decoding="async"
                class="mx-auto h-auto w-32 sm:w-40"
              />
            )}
            {welcomeHeading && <h2 class:list={[SECTION_HEADING, welcomeLogo && 'mt-6 sm:mt-8']}>{welcomeHeading}</h2>}
            {welcomeText && <PortableTextContent value={welcomeText} class:list={['mx-auto max-w-2xl', BODY_TEXT, (welcomeLogo || welcomeHeading) && 'mt-8 sm:mt-10']} />}
          </div>
          {welcomeImage && (
            <div data-fade-up class="mx-auto mt-14 max-w-4xl sm:mt-16">
              <ContentImage image={welcomeImage} sizes="(min-width: 1024px) 896px, calc(100vw - 2rem)" />
            </div>
          )}
        </Container>
      </section>
    )
  }

  {/* 3. Unsere Idee – Sandbeige: Einleitung, darunter die Kerngedanken als ruhige Spalten (keine Karten). */}
  {
    hasIdea && (
      <section class="bg-sand-100/45 py-20 sm:py-24 lg:py-28">
        <Container>
          {(ideaHeading || ideaText) && (
            <div data-fade-up>
              {ideaHeading && <h2 class={SECTION_HEADING}>{ideaHeading}</h2>}
              {ideaText && <PortableTextContent value={ideaText} class:list={['mx-auto max-w-2xl', BODY_TEXT, ideaHeading && 'mt-8 sm:mt-10']} />}
            </div>
          )}
          {ideaPoints.length > 0 && (
            <ul
              class:list={[
                'mx-auto grid gap-10 sm:gap-12 md:gap-8 lg:gap-12',
                ideaPoints.length >= 3 ? 'max-w-5xl md:grid-cols-3' : ideaPoints.length === 2 ? 'max-w-4xl md:grid-cols-2' : 'max-w-2xl',
                (ideaHeading || ideaText) && 'mt-14 sm:mt-16 lg:mt-20',
              ]}
            >
              {ideaPoints.map((point, index) => {
                const imageUrl = point.image?.asset ? urlFor(point.image).width(112).height(112).fit('crop').auto('format').url() : null;
                const hasIcon = !imageUrl && point.icon && point.icon !== 'none';
                return (
                  <li data-fade-up style={`--fade-up-delay: ${(index % 3) * 100}ms`} class="border-l-2 border-sand-300 pl-6 sm:pl-7">
                    {imageUrl ? (
                      <img src={imageUrl} alt={point.image?.alt ?? ''} width="56" height="56" loading="lazy" class="mb-5 h-14 w-14 rounded-full object-cover" />
                    ) : hasIcon ? (
                      <span class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-paper text-anchor-700 ring-1 ring-sand-200">
                        <CoreValueIcon icon={point.icon!} />
                      </span>
                    ) : null}
                    <h3 class="font-display text-2xl leading-snug font-medium text-anchor-800 sm:text-[1.75rem]">{point.title}</h3>
                    {point.text && <p class="mt-3 text-pretty text-lg leading-relaxed text-ink-soft">{point.text}</p>}
                  </li>
                );
              })}
            </ul>
          )}
        </Container>
      </section>
    )
  }

  {/* 4. Mitmachen – salbeigrüne Fläche über die volle Breite, kompakter Inhalt, dunkelgrüner Button. */}
  {
    hasJoin && (
      <section class="bg-anchor-100/60 py-20 sm:py-24">
        <Container>
          <div data-fade-up class="text-center">
            {joinHeading && <h2 class={SECTION_HEADING}>{joinHeading}</h2>}
            {joinText && (
              <PortableTextContent
                value={joinText}
                class:list={[
                  'mx-auto max-w-2xl text-pretty [&_p]:text-lg [&_p]:leading-relaxed [&_p]:text-ink-soft [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&>p+p]:mt-3',
                  'sm:[&>p:first-child]:text-xl [&>p:first-child]:font-medium [&>p:first-child]:text-anchor-800',
                  joinHeading && 'mt-6 sm:mt-8',
                ]}
              />
            )}
            {showJoinButton && (
              <div class:list={[(joinHeading || joinText) && 'mt-9']}>
                <CtaButton
                  href={joinHref!}
                  size="lg"
                  class="shadow-[0_6px_18px_-8px_rgba(21,48,46,0.55)] hover:shadow-[0_10px_24px_-10px_rgba(21,48,46,0.6)]"
                >
                  <svg viewBox="0 0 20 20" fill="none" class="h-5 w-5" aria-hidden="true">
                    <rect x="2.75" y="4.25" width="14.5" height="11.5" rx="1.75" stroke="currentColor" stroke-width="1.5" />
                    <path d="m3.5 5.5 6.5 5 6.5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {joinButtonText}
                </CtaButton>
              </div>
            )}
          </div>
        </Container>
      </section>
    )
  }

  {/* 5. Ankerpunkt in Bildern – optional, warmweiß; ohne Bilder komplett ausgeblendet. */}
  {
    hasGallery && (
      <section class="py-20 sm:py-24 lg:py-28">
        <Container>
          {galleryHeading && (
            <h2 data-fade-up class={SECTION_HEADING}>
              {galleryHeading}
            </h2>
          )}
          <ul class:list={['grid gap-5 sm:gap-6', galleryColumns, galleryHeading && 'mt-12 sm:mt-14']}>
            {galleryImages.map((image, index) => (
              <li data-fade-up style={`--fade-up-delay: ${(index % 3) * 100}ms`}>
                <figure class="m-0">
                  <img
                    src={gallerySrc(image, 960)}
                    srcset={GALLERY_WIDTHS.map((w) => `${gallerySrc(image, w)} ${w}w`).join(', ')}
                    sizes={galleryImages.length === 1 ? '(min-width: 768px) 768px, calc(100vw - 2rem)' : '(min-width: 1024px) 400px, (min-width: 640px) 50vw, calc(100vw - 2rem)'}
                    width="960"
                    height="720"
                    alt={image.alt ?? ''}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/3] h-auto w-full rounded-2xl bg-paper-muted object-cover"
                  />
                  {image.aiGenerated && <AiImageNote />}
                  {image.caption && <figcaption class="mt-3 text-sm leading-relaxed text-ink-soft">{image.caption}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
        </Container>
      </section>
    )
  }
</BaseLayout>
