---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PortableTextContent from '../components/PortableTextContent.astro';
import { getSettings } from '../lib/sanity/api';

// Der vollständige Impressumstext kommt ausschließlich aus Sanity (Globale Einstellungen → Rechtliche
// Seiten → „Impressum – vollständiger Text“). Es gibt bewusst keine Ersatztexte im Code: Fehlt der Text, zeigt
// die Seite nur ihre Überschrift, und das Studio weist auf den fehlenden Inhalt hin.
const settings = await getSettings();
const churchName = settings?.churchName ?? 'Ankerpunkt';
const content = settings?.imprintText?.length ? settings.imprintText : undefined;
if (!content) console.warn('[impressum] Kein Impressumstext in Sanity veröffentlicht – die Seite zeigt nur die Überschrift.');
---

<BaseLayout title="Impressum" description={`Impressum von ${churchName}.`}>
  <Container class="py-16 sm:py-20">
    <h1 class="text-balance text-center font-display text-3xl leading-tight font-medium break-words hyphens-auto text-ink sm:text-5xl">Impressum</h1>

    {
      content && (
        <div class="mx-auto mt-12 max-w-[50rem] sm:mt-14">
          <PortableTextContent value={content} variant="legal" />
        </div>
      )
    }
  </Container>
</BaseLayout>
