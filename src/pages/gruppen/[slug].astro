---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import PersonCard from '../../components/PersonCard.astro';
import { urlFor } from '../../lib/sanity/image';
import { WEEKDAY_LABELS } from '../../lib/format';
import { getGroupBySlug, getGroupSlugs } from '../../lib/sanity/api';

export async function getStaticPaths() {
  const slugs = await getGroupSlugs();
  return slugs.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const group = await getGroupBySlug(slug);

if (!group) {
  return Astro.redirect('/gruppen');
}

const imageUrl = group.image?.asset ? urlFor(group.image).width(1600).height(900).fit('crop').url() : null;

const contactTypeLabels: Record<string, string> = {
  email: 'E-Mail',
  phone: 'Telefon',
  whatsapp: 'WhatsApp',
  link: 'Link',
  other: 'Kontakt',
};
---

<BaseLayout title={group.name} description={group.description}>
  <article class="py-16 sm:py-20">
    <Container class="max-w-3xl">
      <a href="/gruppen" class="inline-flex items-center gap-1.5 text-sm font-medium text-anchor-700 hover:text-anchor-900">
        <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4" aria-hidden="true">
          <path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Alle Gruppen
      </a>

      {group.ageGroup && <p class="mt-6 text-sm font-medium text-anchor-600">{group.ageGroup}</p>}
      <h1 class="mt-2 font-display text-3xl font-medium text-ink sm:text-4xl">{group.name}</h1>

      <div data-fade-up class="mt-10 aspect-[16/9] overflow-hidden rounded-3xl">
        {
          imageUrl ? (
            <img src={imageUrl} alt={group.image?.alt ?? ''} class="h-full w-full object-cover" />
          ) : (
            <PlaceholderImage class="h-full w-full" label={group.name} />
          )
        }
      </div>

      {group.description && <p class="mt-10 text-lg leading-relaxed text-ink-soft">{group.description}</p>}

      {
        group.schedule && (
          <div class="mt-8 flex items-start gap-3 rounded-2xl bg-anchor-50/60 p-6">
            <svg viewBox="0 0 16 16" fill="none" class="mt-0.5 h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
              <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3" />
              <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
            </svg>
            <div>
              <p class="text-xs font-medium tracking-wide text-anchor-700 uppercase">Regelmäßiger Termin</p>
              <p class="mt-1 text-sm text-ink">
                {WEEKDAY_LABELS[group.schedule.weekday]}, {group.schedule.time}
                {group.schedule.location && ` · ${group.schedule.location}`}
              </p>
            </div>
          </div>
        )
      }

      {
        group.contactOptions && group.contactOptions.length > 0 && (
          <div class="mt-8">
            <p class="text-xs font-medium tracking-wide text-anchor-700 uppercase">Weitere Kontaktmöglichkeiten</p>
            <ul class="mt-3 space-y-2">
              {group.contactOptions.map((option) => (
                <li class="flex items-center gap-2 text-sm">
                  <span class="rounded-full bg-anchor-50 px-2.5 py-1 text-xs font-medium text-anchor-700">
                    {contactTypeLabels[option.type] ?? option.type}
                  </span>
                  <a
                    href={option.type === 'email' ? `mailto:${option.value}` : option.type === 'phone' ? `tel:${option.value}` : option.value}
                    target={option.type === 'link' || option.type === 'whatsapp' ? '_blank' : undefined}
                    rel={option.type === 'link' || option.type === 'whatsapp' ? 'noopener noreferrer' : undefined}
                    class="text-anchor-700 hover:text-anchor-900"
                  >
                    {option.label || option.value}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {group.contactPerson && <PersonCard person={group.contactPerson} class="mt-10" data-fade-up />}
    </Container>
  </article>
</BaseLayout>
