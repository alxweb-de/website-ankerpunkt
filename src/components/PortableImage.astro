---
import { urlFor } from '../lib/sanity/image';

const { node } = Astro.props;
const imageUrl = node?.asset ? urlFor(node).width(1200).height(720).fit('crop').url() : null;
---

{
  imageUrl && (
    <figure class="not-prose my-8">
      <img src={imageUrl} alt={node.alt ?? ''} loading="lazy" class="w-full rounded-2xl" />
    </figure>
  )
}
