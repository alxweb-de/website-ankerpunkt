---
import { EVENT_STATUS_LABELS } from '../lib/format';
import type { EventStatus } from '../lib/sanity/types';

interface Props {
  status: EventStatus;
  class?: string;
}

const { status, class: className = '' } = Astro.props;

if (status === 'planned') {
  return null;
}

const styles: Record<EventStatus, string> = {
  planned: '',
  soldOut: 'bg-sand-100 text-sand-800',
  cancelled: 'bg-rose-100 text-rose-800',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold tracking-wide uppercase',
    styles[status],
    className,
  ]}
>
  {EVENT_STATUS_LABELS[status]}
</span>
