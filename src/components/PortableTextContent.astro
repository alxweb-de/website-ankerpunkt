---
import { PortableText } from 'astro-portabletext';
import PortableImage from './PortableImage.astro';
import type { PortableTextValue } from '../lib/sanity/types';

interface Props {
  value: PortableTextValue | undefined;
  class?: string;
  /** Fade-up beim Scrollen (siehe FadeUp.astro). */
  'data-fade-up'?: boolean;
}

const { value, class: className = '', 'data-fade-up': fadeUp } = Astro.props;

const components = {
  type: { image: PortableImage },
};
---

{
  value && (
    <div class:list={['prose-ankerpunkt prose max-w-none', className]} data-fade-up={fadeUp}>
      <PortableText value={value} components={components} />
    </div>
  )
}
