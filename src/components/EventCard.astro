---
import StatusBadge from './StatusBadge.astro';
import { berlinDateKey, formatEventDate } from '../lib/format';
import type { EventItem } from '../lib/sanity/types';

interface Props {
  event: EventItem;
  class?: string;
}

const { event, class: className = '' } = Astro.props;
const labels = formatEventDate(event);
const isToday = event.date === berlinDateKey(new Date());
const isCancelled = event.status === 'cancelled';
---

{/* Einheitliche Terminkarte ohne Bild: großes Datumsfeld als ruhiger Blickfang, darunter Wochentag,
    Uhrzeit und Titel. data-event-* steuert das Ausblenden abgelaufener Termine im Browser
    (scripts/eventExpiry.ts). */}
<a
  href={event.href}
  class:list={['group relative flex h-full flex-col overflow-hidden card-shell p-6 sm:p-7', className]}
  data-event-end={event.visibleUntil}
  data-event-date={event.date}
>
  <span class="absolute inset-x-0 top-0 h-1 bg-anchor-600/80" aria-hidden="true" />

  <div class="flex items-start justify-between gap-4">
    <time
      datetime={event.date}
      class="flex h-[4.5rem] w-[4.5rem] shrink-0 flex-col items-center justify-center rounded-2xl bg-anchor-50 text-anchor-900 ring-1 ring-anchor-100"
    >
      <span class="sr-only">{labels.fullDate}</span>
      <span class="text-[1.75rem] leading-none font-semibold tabular-nums" aria-hidden="true">{labels.day}</span>
      <span class="mt-1.5 text-xs font-medium tracking-wider text-anchor-700 uppercase" aria-hidden="true">{labels.month}</span>
    </time>

    <div class="flex flex-wrap justify-end gap-2">
      <span
        class="rounded-full bg-anchor-100 px-2.5 py-1 text-xs font-semibold tracking-wide text-anchor-800 uppercase"
        data-event-today
        hidden={!isToday}
      >
        Heute
      </span>
      {event.status && event.status !== 'planned' && <StatusBadge status={event.status} />}
    </div>
  </div>

  <p class="mt-6 text-xs font-semibold tracking-wide text-anchor-600 uppercase">{labels.weekdayTimeLabel}</p>
  <h3
    class:list={[
      'mt-2 font-display text-xl leading-snug font-medium break-words text-ink transition-colors group-hover:text-anchor-800',
      isCancelled && 'text-ink-soft line-through decoration-ink/30',
    ]}
  >
    {event.title}
  </h3>

  {/* Platzhalter: hält die Fußzeile bei unterschiedlich langen Titeln auf gleicher Höhe. */}
  <div class="min-h-6 flex-1" aria-hidden="true" />

  <div class="flex items-end justify-between gap-3 border-t border-ink/8 pt-4">
    <span class="text-sm text-ink-soft/80">{labels.shortDate}</span>
    <span class="flex shrink-0 items-center gap-1 text-sm font-medium text-anchor-700">
      Details
      <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>
</a>
