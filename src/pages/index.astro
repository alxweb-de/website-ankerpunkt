---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import CtaButton from '../components/CtaButton.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NewsCard from '../components/NewsCard.astro';
import EventCard from '../components/EventCard.astro';
import MediaFrame from '../components/MediaFrame.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import { urlFor } from '../lib/sanity/image';
import { WEEKDAY_LABELS } from '../lib/format';
import { getHomePage, getNewsList, getRecurringEvents, getSettings, getUpcomingEventsLimited } from '../lib/sanity/api';

const homePage = await getHomePage();
const settings = await getSettings();
const recurringEvents = await getRecurringEvents();

const featuredEvents = homePage?.featuredEvents?.length
  ? [...homePage.featuredEvents].sort(
      (a, b) => new Date(a.startDateTime).getTime() - new Date(b.startDateTime).getTime(),
    )
  : await getUpcomingEventsLimited(3);

const featuredNews = homePage?.featuredNews?.length
  ? homePage.featuredNews
  : (await getNewsList()).slice(0, 3);

const heroImageUrl = homePage?.heroImage?.asset
  ? urlFor(homePage.heroImage).width(1400).fit('max').auto('format').url()
  : null;

const ankerpunktImageUrl = homePage?.ankerpunktSection?.image?.asset
  ? urlFor(homePage.ankerpunktSection.image).width(900).height(1100).fit('crop').url()
  : null;

const livestreamUrl = homePage?.livestreamSection?.overrideUrl ?? settings?.livestreamUrl;
const showLivestream = homePage?.livestreamSection?.isVisible && livestreamUrl;

const heroFacts = [
  { label: 'Sonntags, 10:00 Uhr', icon: 'clock' },
  { label: 'Für alle Generationen', icon: 'users' },
  { label: 'Mitten in Rengsdorf', icon: 'pin' },
];
---

<BaseLayout title="Willkommen">
  <section class="relative overflow-hidden">
    <div
      class="bg-dot-grid pointer-events-none absolute inset-0 opacity-40 [mask-image:radial-gradient(ellipse_60%_55%_at_50%_0%,black,transparent)]"
    >
    </div>
    <div class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full bg-sand-200/40 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-anchor-100/60 blur-3xl"></div>

    <Container class="relative grid grid-cols-1 items-center gap-12 py-16 lg:grid-cols-2 lg:gap-16 lg:py-24">
      <div class="motion-safe:animate-fade-up">
        {
          homePage?.heroEyebrow && (
            <p class="flex items-center gap-2 text-sm font-semibold tracking-wide text-anchor-600 uppercase">
              <span class="h-px w-6 bg-anchor-400"></span>
              {homePage.heroEyebrow}
            </p>
          )
        }
        <h1 class="mt-5 text-balance font-display text-4xl leading-[1.1] font-medium text-ink sm:text-5xl lg:text-[3.35rem]">
          {homePage?.heroHeading ?? 'Willkommen bei Ankerpunkt'}
        </h1>
        {
          homePage?.heroText && (
            <p class="mt-5 max-w-lg text-pretty text-lg leading-relaxed text-ink-soft">{homePage.heroText}</p>
          )
        }
        <div class="mt-8 flex flex-wrap gap-4">
          {homePage?.primaryButton && <CtaButton href={homePage.primaryButton.url}>{homePage.primaryButton.label}</CtaButton>}
          {
            homePage?.secondaryButton && (
              <CtaButton href={homePage.secondaryButton.url} variant="secondary">
                {homePage.secondaryButton.label}
              </CtaButton>
            )
          }
        </div>

        <dl class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-ink/8 pt-6">
          {
            heroFacts.map((fact) => (
              <div class="flex items-center gap-2 text-sm text-ink-soft">
                {fact.icon === 'clock' && (
                  <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 shrink-0 text-anchor-500" aria-hidden="true">
                    <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3" />
                    <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                  </svg>
                )}
                {fact.icon === 'users' && (
                  <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 shrink-0 text-anchor-500" aria-hidden="true">
                    <circle cx="5.5" cy="6" r="2.2" stroke="currentColor" stroke-width="1.2" />
                    <path d="M1.6 13c.4-2.2 2-3.5 3.9-3.5s3.5 1.3 3.9 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                    <circle cx="11.2" cy="6.4" r="1.8" stroke="currentColor" stroke-width="1.2" />
                    <path d="M9.8 9.7c1.5.1 2.7 1.3 3 3.3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                  </svg>
                )}
                {fact.icon === 'pin' && (
                  <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 shrink-0 text-anchor-500" aria-hidden="true">
                    <path d="M8 14.5S13 10 13 6.5a5 5 0 1 0-10 0C3 10 8 14.5 8 14.5Z" stroke="currentColor" stroke-width="1.3" />
                    <circle cx="8" cy="6.5" r="1.8" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                )}
                <span>{fact.label}</span>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="motion-safe:animate-fade-up motion-safe:[animation-delay:150ms]">
        <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
          {
            heroImageUrl ? (
              <img
                src={heroImageUrl}
                alt={homePage?.heroImage?.alt ?? ''}
                class="h-auto w-full object-contain"
                fetchpriority="high"
              />
            ) : (
              <PlaceholderImage class="aspect-[4/5] w-full rounded-3xl" label="Ankerpunkt Gemeindehaus in Rengsdorf" />
            )
          }
          {
            heroImageUrl && (
              <div class="absolute bottom-4 left-4 flex items-center gap-1.5 rounded-full bg-white/90 px-3 py-1.5 text-xs font-medium text-anchor-900 shadow-sm backdrop-blur-sm">
                <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5 shrink-0" aria-hidden="true">
                  <path d="M8 14.5S13 10 13 6.5a5 5 0 1 0-10 0C3 10 8 14.5 8 14.5Z" stroke="currentColor" stroke-width="1.3" />
                  <circle cx="8" cy="6.5" r="1.8" stroke="currentColor" stroke-width="1.3" />
                </svg>
                Rengsdorf &middot; Westerwald
              </div>
            )
          }
        </div>
      </div>
    </Container>
  </section>

  <section class="py-20">
    <Container>
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
        <SectionHeading eyebrow="Termine" heading="Nächste Veranstaltungen" />
        <CtaButton href="/veranstaltungen" variant="ghost">Alle Veranstaltungen ansehen →</CtaButton>
      </div>

      {
        featuredEvents.length > 0 ? (
          <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {featuredEvents.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        ) : (
          <p class="mt-10 text-ink-soft">Aktuell sind keine Veranstaltungen geplant. Schau bald wieder vorbei.</p>
        )
      }
    </Container>
  </section>

  <section class="border-y border-ink/8 bg-paper-muted py-20">
    <Container>
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
        <SectionHeading eyebrow="Aktuelles" heading="Neuigkeiten aus der Gemeinde" />
        <CtaButton href="/neuigkeiten" variant="ghost">Alle Neuigkeiten ansehen →</CtaButton>
      </div>

      {
        featuredNews.length > 0 ? (
          <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {featuredNews.map((news) => (
              <NewsCard news={news} />
            ))}
          </div>
        ) : (
          <p class="mt-10 text-ink-soft">Aktuell gibt es keine Neuigkeiten.</p>
        )
      }
    </Container>
  </section>

  {
    recurringEvents.length > 0 && (
      <section class="py-20">
        <Container>
          <SectionHeading eyebrow="Jede Woche" heading="Regelmäßige Veranstaltungen" align="center" class="mx-auto" />
          <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {recurringEvents.map((item) => (
              <div class="card-shell flex flex-col p-6">
                <div class="flex items-center gap-2 text-sm font-semibold text-anchor-700">
                  <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 shrink-0" aria-hidden="true">
                    <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3" />
                    <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                  </svg>
                  {WEEKDAY_LABELS[item.weekday]}
                </div>
                <p class="mt-1 text-sm text-ink-soft/80">{item.time}</p>
                <h3 class="mt-3 font-display text-lg font-medium text-ink">{item.title}</h3>
                {item.excerpt && <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-soft">{item.excerpt}</p>}
                <p class="mt-4 border-t border-ink/8 pt-3 text-xs text-ink-soft/70">{item.location}</p>
              </div>
            ))}
          </div>
        </Container>
      </section>
    )
  }

  {
    homePage?.ankerpunktSection && (homePage.ankerpunktSection.heading || homePage.ankerpunktSection.text) && (
      <section class="border-t border-ink/8 bg-paper-muted py-20">
        <Container class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <div class="order-2 lg:order-1">
            <MediaFrame class="aspect-[4/5] w-full rounded-3xl shadow-lg shadow-anchor-900/10">
              {ankerpunktImageUrl ? (
                <img src={ankerpunktImageUrl} alt={homePage.ankerpunktSection.image?.alt ?? ''} class="h-full w-full object-cover" loading="lazy" />
              ) : (
                <PlaceholderImage class="h-full w-full" label="Was ist Ankerpunkt?" />
              )}
            </MediaFrame>
          </div>
          <div class="order-1 lg:order-2">
            <SectionHeading eyebrow="Über uns" heading={homePage.ankerpunktSection.heading ?? 'Was ist Ankerpunkt?'} text={homePage.ankerpunktSection.text} />
            {homePage.ankerpunktSection.link && (
              <div class="mt-8">
                <CtaButton href={homePage.ankerpunktSection.link.url}>{homePage.ankerpunktSection.link.label}</CtaButton>
              </div>
            )}
          </div>
        </Container>
      </section>
    )
  }

  {
    showLivestream && (
      <section class="bg-anchor-900 py-20 text-paper">
        <Container class="flex flex-col items-center gap-6 text-center">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-anchor-800 ring-1 ring-anchor-700">
            <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5 text-paper" aria-hidden="true">
              <path d="M5 7a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7Z" stroke="currentColor" stroke-width="1.5" />
              <path d="M15 10l4-2.5v9L15 14" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </span>
          <SectionHeading
            heading={homePage?.livestreamSection?.heading || 'Gottesdienst per Livestream verfolgen'}
            text={homePage?.livestreamSection?.text}
            align="center"
            class="text-paper [&_p]:text-anchor-100 [&_h2]:text-paper"
          />
          <CtaButton href={livestreamUrl!} variant="inverse">Zum Livestream</CtaButton>
        </Container>
      </section>
    )
  }

  <section class="py-20">
    <Container class="rounded-3xl bg-anchor-50 px-8 py-12 ring-1 ring-anchor-100 sm:px-16">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
        <div>
          <SectionHeading eyebrow="Besuch uns" heading="Wir freuen uns auf dich" text="Ob zum Gottesdienst, einer Veranstaltung oder einfach auf einen Kaffee – komm gerne vorbei." />
          <div class="mt-8">
            <CtaButton href="/kontakt">Kontakt aufnehmen</CtaButton>
          </div>
        </div>
        <div class="space-y-4 text-ink-soft">
          {
            settings?.address && (
              <p class="flex items-start gap-3">
                <svg viewBox="0 0 16 16" fill="none" class="mt-0.5 h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
                  <path d="M8 14.5S13 10 13 6.5a5 5 0 1 0-10 0C3 10 8 14.5 8 14.5Z" stroke="currentColor" stroke-width="1.3" />
                  <circle cx="8" cy="6.5" r="1.8" stroke="currentColor" stroke-width="1.3" />
                </svg>
                <span>
                  {settings.address.street}<br />
                  {settings.address.zip} {settings.address.city}
                </span>
              </p>
            )
          }
          {
            settings?.phone && (
              <p class="flex items-center gap-3">
                <svg viewBox="0 0 16 16" fill="none" class="h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
                  <path d="M3 3.5c0-.6.4-1 1-1h2l1.3 3-1.3 1a8 8 0 0 0 4 4l1-1.3 3 1.3v2c0 .6-.4 1-1 1A10 10 0 0 1 3 3.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
                </svg>
                <a href={`tel:${settings.phone.replace(/\s+/g, '')}`} class="hover:text-anchor-800">{settings.phone}</a>
              </p>
            )
          }
          {
            settings?.email && (
              <p class="flex items-center gap-3">
                <svg viewBox="0 0 16 16" fill="none" class="h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
                  <rect x="2" y="3.5" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.2" />
                  <path d="m3 4.5 5 4 5-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <a href={`mailto:${settings.email}`} class="hover:text-anchor-800">{settings.email}</a>
              </p>
            )
          }
          {
            settings?.officeHours?.map((entry) => (
              <p class="flex items-start gap-3">
                <svg viewBox="0 0 16 16" fill="none" class="mt-0.5 h-5 w-5 shrink-0 text-anchor-600" aria-hidden="true">
                  <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.2" />
                  <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                </svg>
                <span><strong class="font-medium text-ink">{entry.label}:</strong> {entry.hours}</span>
              </p>
            ))
          }
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
